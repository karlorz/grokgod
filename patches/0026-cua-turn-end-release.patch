+use super::*;
+
+async fn attach_cua(
+    h: &Harness,
+) -> (
+    Arc<parking_lot::Mutex<Vec<serde_json::Value>>>,
+    Arc<tokio::sync::Notify>,
+) {
+    use axum::response::IntoResponse;
+    use xai_grok_mcp::servers::{HttpConfig, McpClient, McpClientTimeoutOverrides};
+    let calls = Arc::new(parking_lot::Mutex::new(Vec::new()));
+    let release = Arc::new(tokio::sync::Notify::new());
+    let capture = calls.clone();
+    let gate = release.clone();
+    let app = axum::Router::new().route("/mcp", axum::routing::post(move |axum::Json(req): axum::Json<serde_json::Value>| {
+        let capture = capture.clone();
+        let gate = gate.clone();
+        async move {
+            let id = req["id"].clone();
+            match req["method"].as_str() {
+                Some("initialize") => axum::Json(serde_json::json!({"jsonrpc":"2.0","id":id,"result":{
+                    "protocolVersion":req["params"]["protocolVersion"],"capabilities":{},"serverInfo":{"name":"cua-fixture","version":"1"}
+                }})).into_response(),
+                Some("tools/call") => {
+                    capture.lock().push(req["params"].clone());
+                    gate.notified().await;
+                    axum::Json(serde_json::json!({"jsonrpc":"2.0","id":id,"result":{"content":[],"isError":false}})).into_response()
+                }
+                _ => axum::http::StatusCode::ACCEPTED.into_response(),
+            }
+        }
+    }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}/mcp", listener.local_addr().unwrap());
+    tokio::task::spawn_local(async move {
+        axum::serve(listener, app).await.unwrap();
+    });
+    let client = Arc::new(McpClient::new_http(
+        "cua_repl".into(),
+        HttpConfig {
+            url,
+            ..Default::default()
+        },
+        Some(&McpClientTimeoutOverrides {
+            startup_timeout_sec: Some(2),
+            ..Default::default()
+        }),
+        None,
+    ));
+    client.ensure_initialized().await.unwrap();
+    h.actor
+        .mcp_state
+        .lock()
+        .await
+        .owned_clients
+        .insert("cua_repl".into(), client);
+    (calls, release)
+}
+
+async fn wait_for_cleanup(calls: &parking_lot::Mutex<Vec<serde_json::Value>>) {
+    tokio::time::timeout(std::time::Duration::from_secs(2), async {
+        while calls.lock().is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
+
+fn completed() -> PromptTurnResult {
+    Ok(PromptTurnOk {
+        stop_reason: acp::StopReason::EndTurn,
+        total_tokens: 0,
+        turn_snapshot: None,
+        completion_kind: PromptCompletionKind::Completed,
+        structured_output: None,
+        usage: None,
+        tool_overrides: None,
+    })
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn cua_cleanup_completion_and_failure_precede_prompt_response() {
+    run(async {
+        for failed in [false, true] {
+            let h = Harness::new().await;
+            let (calls, release) = attach_cua(&h).await;
+            let mut response = h.queue_turn("cua-prompt").await;
+            let actor = h.actor.clone();
+            let epoch = actor.turn_report.epoch();
+            let identity = completion_identity(&actor);
+            let task = tokio::task::spawn_local(async move {
+                actor
+                    .handle_completion(
+                        "cua-prompt".into(),
+                        epoch,
+                        &identity,
+                        if failed {
+                            Err(acp::Error::internal_error())
+                        } else {
+                            completed()
+                        },
+                        Some(0),
+                    )
+                    .await
+            });
+            wait_for_cleanup(&calls).await;
+            assert!(matches!(
+                response.try_recv(),
+                Err(tokio::sync::oneshot::error::TryRecvError::Empty)
+            ));
+            assert_eq!(calls.lock()[0]["arguments"]["turn_id"], "cua-prompt");
+            assert_eq!(calls.lock()[0]["arguments"]["hook_event_name"], "Stop");
+            release.notify_one();
+            assert!(task.await.unwrap());
+            assert_eq!(response.await.unwrap().is_err(), failed);
+        }
+    })
+    .await;
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn cua_cleanup_cancel_and_close_use_interrupt() {
+    run(async {
+        let h = Harness::new().await;
+        let (calls, release) = attach_cua(&h).await;
+        let mut response = h.queue_turn("cancelled-cua").await;
+        let actor = h.actor.clone();
+        let task = tokio::task::spawn_local(async move {
+            actor
+                .cancel_running_task(crate::session::CancelOptions {
+                    cancel_subagents: true,
+                    kill_background_tasks: true,
+                    history: crate::session::CancelHistoryDisposition::Keep,
+                    trigger: Some(CancelTrigger::Esc),
+                    user_initiated: true,
+                })
+                .await
+        });
+        wait_for_cleanup(&calls).await;
+        assert!(matches!(
+            response.try_recv(),
+            Err(tokio::sync::oneshot::error::TryRecvError::Empty)
+        ));
+        assert_eq!(calls.lock()[0]["arguments"]["hook_event_name"], "Interrupt");
+        release.notify_one();
+        task.await.unwrap();
+        assert_eq!(
+            response.await.unwrap().unwrap().stop_reason,
+            acp::StopReason::Cancelled
+        );
+        calls.lock().clear();
+        release.notify_one();
+        h.actor.release_computer_use_on_close().await;
+        assert_eq!(calls.lock()[0]["arguments"]["hook_event_name"], "Interrupt");
+    })
+    .await;
+}
