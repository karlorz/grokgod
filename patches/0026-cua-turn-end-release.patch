--- /dev/null
+++ b/crates/codegen/xai-grok-mcp/src/cua_cleanup.rs
@@ -0,0 +1,129 @@
+//! Host cleanup for the user-installed Computer Use MCP, on its existing connection.
+
+use super::*;
+
+pub(super) fn configure_mac_sky_release(
+    name: &str,
+    env: &[acp::EnvVariable],
+    cmd: &mut Command,
+) -> Result<bool, McpError> {
+    if !cfg!(target_os = "macos") || name != "cua_repl" {
+        return Ok(false);
+    }
+    let value = |key: &str| {
+        env.iter()
+            .rev()
+            .find(|item| item.name == key)
+            .map(|item| item.value.clone())
+            .or_else(|| std::env::var(key).ok())
+    };
+    let surfaces = value("CUA_REPL_ENABLED_SURFACES").unwrap_or_default();
+    if !surfaces.split(',').any(|s| s.trim() == "computer") {
+        return Ok(false);
+    }
+    let mut defaults = serde_json::json!({"sky": "@oai/sky/service"});
+    if surfaces.split(',').any(|s| s.trim() == "browser") {
+        defaults["browser"] = serde_json::json!("@oai/browser-desktop/service");
+    }
+    let mut services: serde_json::Value = match value("NODE_REPL_TRUSTED_SERVICES") {
+        Some(value) => serde_json::from_str(&value).map_err(|_| {
+            McpError::ClientError("Invalid Computer Use trusted services configuration".into())
+        })?,
+        None => defaults,
+    };
+    if services.get("sky").and_then(serde_json::Value::as_str) != Some("@oai/sky/service") {
+        return Err(McpError::ClientError(
+            "Grok Computer Use turn cleanup requires @oai/sky/service".into(),
+        ));
+    }
+    let dir = xai_grok_config::grok_home().join("computer-use");
+    let write = || -> std::io::Result<std::path::PathBuf> {
+        use std::io::Write;
+        std::fs::create_dir_all(&dir)?;
+        let file = dir.join("sky-release-service.mjs");
+        let source = include_bytes!("cua_sky_service.mjs");
+        if std::fs::read(&file).ok().as_deref() != Some(source.as_slice()) {
+            let mut temp = tempfile::NamedTempFile::new_in(&dir)?;
+            temp.write_all(source)?;
+            temp.persist(&file).map_err(|e| e.error)?;
+        }
+        Ok(file)
+    };
+    let file = write().map_err(|e| {
+        McpError::ClientError(format!("Cannot install Computer Use release bridge: {e}"))
+    })?;
+    services["sky"] = serde_json::Value::String(file.to_string_lossy().into_owned());
+    cmd.env("NODE_REPL_TRUSTED_SERVICES", services.to_string());
+    let mut trusted: Vec<_> = value("NODE_REPL_TRUSTED_CODE_PATHS")
+        .map(|v| std::env::split_paths(&v).collect())
+        .unwrap_or_default();
+    trusted.push(file);
+    cmd.env(
+        "NODE_REPL_TRUSTED_CODE_PATHS",
+        std::env::join_paths(trusted)
+            .map_err(|_| McpError::ClientError("Invalid Computer Use trusted code paths".into()))?,
+    );
+    Ok(true)
+}
+
+impl McpClient {
+    /// Does not initialize an unused server. A failed cleanup makes this connection unusable.
+    pub async fn notify_cua_turn_ended(
+        &self,
+        hook_event_name: &str,
+        session_id: &str,
+        turn_id: &str,
+    ) -> Result<(), McpError> {
+        if self.server_name != "cua_repl" {
+            return Ok(());
+        }
+        let service = {
+            let state = self.state.lock().await;
+            match &*state {
+                ClientState::Ready { service, .. } => Arc::clone(service),
+                _ => return Ok(()),
+            }
+        };
+        let _request = self.begin_outbound_request();
+        let budget = std::time::Duration::from_secs(3);
+        let mut params = CallToolRequestParams::new("turn_ended");
+        params.arguments = serde_json::json!({
+            "hook_event_name": hook_event_name,
+            "session_id": session_id,
+            "turn_id": turn_id,
+        })
+        .as_object()
+        .cloned();
+        let cleanup = async {
+            let result = service.call_tool(params).await?;
+            if result.is_error == Some(true) {
+                return Ok(result);
+            }
+            if self.cua_native_release {
+                let payload = serde_json::json!({"type": "grok_turn_ended", "sessionId": session_id, "turnId": turn_id});
+                let mut native = CallToolRequestParams::new("js");
+                native.arguments = serde_json::json!({
+                    "code": format!("await nodeRepl.rpc(\"sky\", {payload});"),
+                    "title": "Release Computer Use",
+                })
+                .as_object()
+                .cloned();
+                return service.call_tool(native).await;
+            }
+            Ok(result)
+        };
+        let result = match tokio::time::timeout(budget, cleanup).await {
+            Ok(Ok(result)) if result.is_error != Some(true) => Ok(()),
+            Ok(Ok(_)) => Err(McpError::ClientError(
+                "cua_repl turn_ended returned an error".into(),
+            )),
+            Ok(Err(error)) => Err(McpError::from(error)),
+            Err(_) => Err(McpError::timeout("cua_repl", budget)),
+        };
+        if result.is_err() {
+            self.discard();
+            *self.state.lock().await = ClientState::Empty;
+        }
+        result
+    }
+}
