+use super::*;
+
+fn cua_client(url: &str) -> Arc<McpClient> {
+    let mut client = fake_http_client(url, 60);
+    Arc::get_mut(&mut client).unwrap().server_name = "cua_repl".into();
+    client
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cua_cleanup_uses_existing_connection_and_preserves_it() {
+    let (url, handles) = spawn_fake_mcp(CallToolBehavior::HangThenOk { hang_ms: 0 }).await;
+    let client = cua_client(&url);
+    client.ensure_initialized().await.unwrap();
+    for event in ["Stop", "Interrupt", "SubagentStop"] {
+        client
+            .notify_cua_turn_ended(event, "session", "prompt")
+            .await
+            .unwrap();
+        assert!(client.is_ready().await);
+    }
+    assert_eq!(handles.inits.load(Ordering::Relaxed), 1);
+    let bodies = handles.call_bodies.lock();
+    for (body, event) in bodies.iter().zip(["Stop", "Interrupt", "SubagentStop"]) {
+        assert_eq!(body["params"]["name"], "turn_ended");
+        assert_eq!(
+            body["params"]["arguments"],
+            serde_json::json!({
+                "hook_event_name": event, "session_id": "session", "turn_id": "prompt"
+            })
+        );
+    }
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cua_cleanup_missing_tool_fails_closed_before_admission() {
+    let (url, _) = spawn_fake_mcp(CallToolBehavior::HangThenOk { hang_ms: 0 }).await;
+    let client = cua_client(&url);
+    let state = Arc::new(Mutex::new(McpState::new(vec![])));
+    assert!(client.get_tool_registrations(state).await.is_err());
+    assert_eq!(client.state_kind().await, ClientStateKind::Empty);
+    assert!(client.ensure_initialized().await.is_err());
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cua_cleanup_protocol_error_disables_connection_without_retry() {
+    let (url, handles) = spawn_fake_mcp(CallToolBehavior::AlwaysError { code: -32601 }).await;
+    let client = cua_client(&url);
+    client.ensure_initialized().await.unwrap();
+    assert!(
+        client
+            .notify_cua_turn_ended("Stop", "s", "t")
+            .await
+            .is_err()
+    );
+    assert_eq!(client.state_kind().await, ClientStateKind::Empty);
+    assert_eq!(handles.calls.load(Ordering::Relaxed), 1);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cua_cleanup_timeout_disables_connection() {
+    let (url, handles) = spawn_fake_mcp(CallToolBehavior::HangThenOk { hang_ms: 10_000 }).await;
+    let client = cua_client(&url);
+    client.ensure_initialized().await.unwrap();
+    let started = std::time::Instant::now();
+    assert!(
+        client
+            .notify_cua_turn_ended("Interrupt", "s", "t")
+            .await
+            .unwrap_err()
+            .is_timeout()
+    );
+    assert!(started.elapsed() < std::time::Duration::from_secs(5));
+    assert_eq!(client.state_kind().await, ClientStateKind::Empty);
+    assert_eq!(handles.calls.load(Ordering::Relaxed), 1);
+}
+
+#[tokio::test]
+async fn cua_cleanup_does_not_start_unused_server() {
+    let client = McpClient::stub("cua_repl");
+    client
+        .notify_cua_turn_ended("Stop", "s", "t")
+        .await
+        .unwrap();
+    assert_eq!(client.state_kind().await, ClientStateKind::Empty);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cua_cleanup_tool_is_hidden_and_mac_bridge_runs_after_notification() {
+    let (url, handles) = spawn_fake_mcp_with(
+        CallToolBehavior::HangThenOk { hang_ms: 0 },
+        FakeMcpOptions {
+            cua_cleanup_tool: true,
+            ..Default::default()
+        },
+    )
+    .await;
+    let mut client = cua_client(&url);
+    Arc::get_mut(&mut client).unwrap().cua_native_release = true;
+    let state = Arc::new(Mutex::new(McpState::new(vec![])));
+    let tools = client.get_tool_registrations(state).await.unwrap();
+    assert_eq!(tools.len(), 1);
+    assert_eq!(tools[0].name, "cua_repl__echo");
+    let descriptors = tempfile::tempdir().unwrap();
+    assert_eq!(
+        client
+            .materialize_descriptors(descriptors.path())
+            .await
+            .unwrap(),
+        1
+    );
+    assert!(!descriptors.path().join("tools/turn_ended.json").exists());
+    client
+        .notify_cua_turn_ended("Stop", "session", "prompt")
+        .await
+        .unwrap();
+    let calls = handles.call_bodies.lock();
+    assert_eq!(calls.len(), 2);
+    assert_eq!(calls[0]["params"]["name"], "turn_ended");
+    assert_eq!(calls[1]["params"]["name"], "js");
+    let code = calls[1]["params"]["arguments"]["code"].as_str().unwrap();
+    assert!(code.contains("grok_turn_ended"));
+    assert!(code.contains("\"sessionId\":\"session\""));
+    assert!(client.is_ready().await);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn cua_cleanup_dispatch_carries_matching_turn_metadata() {
+    let (url, handles) = spawn_fake_mcp(CallToolBehavior::HangThenOk { hang_ms: 0 }).await;
+    let client = fake_http_client(&url, 60);
+    let meta = serde_json::json!({"session_id":"session", "turn_id":"prompt", "call_id":"call"});
+    fake_echo_tool()
+        .try_call_tool_with_cua_meta(
+            &client,
+            &serde_json::json!({}),
+            Some(meta.clone()),
+            &mut false,
+            &mut false,
+            &xai_grok_session_events::EventWriter::noop(),
+            &tracing::Span::none(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        handles.call_bodies.lock()[0]["params"]["_meta"]["x-codex-turn-metadata"],
+        meta
+    );
+}
