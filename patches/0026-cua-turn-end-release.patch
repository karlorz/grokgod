+++ b/crates/codegen/xai-grok-mcp/src/cua_sky_service.mjs
@@ -0,0 +1,50 @@
+// Trusted Sky service: preserve the installed API and add native turn cleanup.
+import { createRequire } from "node:module";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+
+const roots = (process.env.NODE_REPL_NODE_MODULE_DIRS ?? "")
+  .split(path.delimiter)
+  .filter(Boolean);
+let servicePath;
+for (const root of roots) {
+  try {
+    servicePath = createRequire(path.join(root, "grok-cua-loader.cjs")).resolve(
+      "@oai/sky/service",
+    );
+    break;
+  } catch {}
+}
+if (!servicePath)
+  throw new Error("Grok Computer Use requires the installed @oai/sky/service");
+const original = await import(pathToFileURL(servicePath).href);
+const { MacNativePipeTransport } = await import(
+  pathToFileURL(
+    path.join(path.dirname(servicePath), "targets/mac/native-pipe.js"),
+  ).href
+);
+let transport;
+
+export async function handleRpc(request) {
+  if (request.type !== "grok_turn_ended") return original.handleRpc(request);
+  const { sessionId, turnId } = request;
+  if (
+    typeof sessionId !== "string" ||
+    !sessionId ||
+    typeof turnId !== "string" ||
+    !turnId
+  ) {
+    throw new Error("Computer Use cleanup requires a session and turn ID");
+  }
+  if (!transport || transport.isClosed) {
+    transport = await MacNativePipeTransport.create("CodexComputerUseIPC-5");
+  }
+  return transport.request({
+    requestType: "ComputerUseIPCCodexTurnEndedRequest",
+    request: { threadID: sessionId, turnID: turnId },
+    codexMetadata: { session_id: sessionId, turn_id: turnId },
+    timeoutSeconds: 2,
+  });
+}
+
+export const classifyError = original.classifyError;
