+//! Computer Use cleanup runs behind the actor's turn-finalization lease.
+
+use super::*;
+
+impl SessionActor {
+    pub(super) async fn release_computer_use(&self, prompt_id: &str, interrupted: bool) {
+        let client = self.mcp_state.lock().await.get_client("cua_repl").cloned();
+        let Some(client) = client else { return };
+        let event = if interrupted {
+            "Interrupt"
+        } else if self.startup_hints.is_subagent {
+            "SubagentStop"
+        } else {
+            "Stop"
+        };
+        if let Err(error) = client
+            .notify_cua_turn_ended(event, &self.session_id_string(), prompt_id)
+            .await
+        {
+            tracing::warn!(%error, "Computer Use cleanup failed; cua_repl connection disabled");
+        }
+    }
+
+    pub(super) async fn release_computer_use_on_close(&self) {
+        let prompt_id = {
+            let state = self.state.lock().await;
+            state.running_prompt_id().map(str::to_owned)
+        }
+        .or_else(|| {
+            self.current_prompt_id
+                .lock()
+                .expect("current_prompt_id mutex poisoned")
+                .clone()
+        })
+        .unwrap_or_else(|| "session-close".to_owned());
+        self.release_computer_use(&prompt_id, true).await;
+    }
+}
