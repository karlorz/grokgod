+/// Claude permissions import gate:
+/// - `claude_permissions: true` (default): permissions in ~/.claude/settings.json are imported.
+/// - `claude_permissions: false`: Claude permissions are skipped, while other tiers still resolve.
+#[test]
+fn claude_permissions_import_gate_controls_resolution() {
+    let _guard = ENV_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+    let rt = tokio::runtime::Builder::new_current_thread()
+        .build()
+        .unwrap();
+
+    let tmp = tempfile::tempdir().unwrap();
+    let claude_dir = tmp.path().join(".claude");
+    std::fs::create_dir_all(&claude_dir).unwrap();
+    std::fs::write(
+        claude_dir.join("settings.json"),
+        r#"{"permissions": {"deny": ["WebFetch"]}}"#,
+    )
+    .unwrap();
+
+    let _home = EnvVarGuard::set("HOME", tmp.path());
+    let _grok_home = EnvVarGuard::set("GROK_HOME", &tmp.path().join(".grok"));
+    let _marker = EnvVarGuard::unset("_GROK_CLAUDE_MARKER_OVERRIDE");
+
+    // 1. claude_permissions: true -> WebFetch deny is present.
+    let mut on_inputs = inputs(None);
+    on_inputs.claude_permissions = true;
+    let resolved = rt
+        .block_on(resolve_permissions_with_provenance_inner(
+            tmp.path(),
+            on_inputs,
+        ))
+        .expect("permissions should resolve");
+    assert!(
+        resolved
+            .config
+            .rules
+            .iter()
+            .any(|r| r.action == RuleAction::Deny && r.tool == ToolFilter::WebFetch),
+        "WebFetch deny should be present when claude_permissions is true"
+    );
+
+    // 2. claude_permissions: false -> WebFetch deny is absent.
+    let mut off_inputs = inputs(None);
+    off_inputs.claude_permissions = false;
+    let resolved = rt.block_on(resolve_permissions_with_provenance_inner(
+        tmp.path(),
+        off_inputs,
+    ));
+    let has_web_fetch_deny = resolved.as_ref().is_some_and(|r| {
+        r.config
+            .rules
+            .iter()
+            .any(|rule| rule.action == RuleAction::Deny && rule.tool == ToolFilter::WebFetch)
+    });
+    assert!(
+        !has_web_fetch_deny,
+        "WebFetch deny should be absent when claude_permissions is false"
+    );
+}
