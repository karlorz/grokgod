+/// Keep generic retry exhaustion on the content-filter recovery path.
+pub(crate) fn content_filter_can_resample(
+    action: crate::config::ContentFilterAction,
+    retry_count: u32,
+    cf_max: u32,
+    effective_max_retries: u32,
+) -> bool {
+    matches!(
+        action,
+        crate::config::ContentFilterAction::Retry
+            | crate::config::ContentFilterAction::RetryThenError
+    ) && retry_count < cf_max
+        && retry_count.saturating_add(1) < effective_max_retries
+}
