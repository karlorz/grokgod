@@ -0,0 +1,112 @@
+//! Content-filter turn recovery: stash the failed prompt and offer switch/retry.
+
+use super::billing::USAGE_LIMIT_SWITCH_MODEL_OPTION_ID;
+use super::queue::{maybe_drain_queue, note_peek_page_flip};
+use crate::app::actions::Effect;
+use crate::app::agent_view::AgentView;
+use crate::app::app_view::AppView;
+use crate::scrollback::block::RenderBlock;
+
+/// Needle shared with `xai_grok_sampler::CONTENT_FILTER_TURN_MESSAGE`.
+pub(crate) const CONTENT_FILTER_TURN_MESSAGE: &str =
+    "The model provider refused to generate a response for this turn (content filter).";
+
+/// Option id for Try Again on the content-filter recovery card.
+pub(crate) const CONTENT_FILTER_RETRY_OPTION_ID: &str = "content-filter-retry-last-prompt";
+
+pub(crate) fn is_content_filter_turn_error(message: &str) -> bool {
+    message.contains(CONTENT_FILTER_TURN_MESSAGE)
+}
+
+/// Open Switch model & retry / Try Again. Distinct from the credit-limit upsell.
+pub(super) fn open_content_filter_recovery(agent: &mut AgentView) {
+    use crate::views::question_view::{LocalQuestionKind, QuestionViewState};
+    use xai_grok_tools::implementations::grok_build::ask_user_question::{
+        Question, QuestionOption,
+    };
+
+    if agent.question_view.is_some() {
+        return;
+    }
+
+    let question = Question {
+        question: "The model provider refused this turn (content filter).".into(),
+        options: vec![
+            QuestionOption {
+                label: "Switch model & retry".into(),
+                description: "Choose another model, then retry the last prompt automatically"
+                    .into(),
+                preview: None,
+                id: Some(USAGE_LIMIT_SWITCH_MODEL_OPTION_ID.into()),
+            },
+            QuestionOption {
+                label: "Try Again".into(),
+                description: "Resubmit the last prompt on the current model".into(),
+                preview: None,
+                id: Some(CONTENT_FILTER_RETRY_OPTION_ID.into()),
+            },
+        ],
+        multi_select: Some(false),
+        id: None,
+    };
+
+    let stashed = agent.prompt.stash();
+    let state = QuestionViewState::new(
+        format!("content-filter-recovery-{}", uuid::Uuid::new_v4()),
+        vec![question],
+        stashed,
+    )
+    .with_local_kind(LocalQuestionKind::ContentFilterRecovery)
+    .with_no_freeform();
+    agent.install_local_question(state);
+    agent.prompt.set_text("");
+}
+
+pub(super) fn dispatch_retry_content_filter_prompt(app: &mut AppView) -> Vec<Effect> {
+    use crate::app::app_view::ActiveView;
+
+    let ActiveView::Agent(agent_id) = app.active_view else {
+        return vec![];
+    };
+    let Some(agent) = app.agents.get_mut(&agent_id) else {
+        return vec![];
+    };
+    let Some(prompt) = agent.content_filter_stashed_prompt.take() else {
+        agent.show_toast("No prompt to retry.");
+        agent
+            .scrollback
+            .push_block(RenderBlock::system("No prompt to retry."));
+        return vec![];
+    };
+    agent.session.enqueue_in_flight_prompt_front(prompt);
+    let drain = maybe_drain_queue(agent, &mut app.pending_image_notices);
+    if drain.effects.iter().any(|effect| {
+        matches!(
+            effect,
+            Effect::SendPrompt { .. }
+                | Effect::SendPromptBlocks { .. }
+                | Effect::SendBashCommand { .. }
+        )
+    }) {
+        agent
+            .scrollback
+            .push_block(RenderBlock::system("Trying again\u{2026}"));
+    }
+    note_peek_page_flip(app, agent_id, drain.page_flip_entry);
+    drain.effects
+}
+
+pub(super) fn dispatch_open_content_filter_model_picker(app: &mut AppView) -> Vec<Effect> {
+    use crate::app::app_view::ActiveView;
+
+    let ActiveView::Agent(agent_id) = app.active_view else {
+        return vec![];
+    };
+    let Some(agent) = app.agents.get_mut(&agent_id) else {
+        return vec![];
+    };
+    if agent.open_model_arg_picker() {
+        agent.content_filter_model_retry_pending = true;
+    }
+    vec![]
+}
