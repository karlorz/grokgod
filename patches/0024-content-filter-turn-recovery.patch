+/// `[compat.content_filter]` TOML table. Empty ContentFilter recovery.
+#[derive(Debug, Clone, Default, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ContentFilterToml {
+    /// `error` | `retry_then_error` | `retry` | `notice`. Absent → `retry_then_error`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub action: Option<String>,
+    /// Resample cap for `retry` / `retry_then_error`. Absent → 3.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub max_retries: Option<u32>,
+}
+
+/// Resolved `[compat.content_filter]` action.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum ContentFilterAction {
+    /// Fail the turn. Session stays recoverable.
+    Error,
+    /// One or more Empty-style resamples, then fail (default).
+    #[default]
+    RetryThenError,
+    /// Resample like EmptyResponse up to max_retries.
+    Retry,
+    /// Upstream: emit the refusal notice and complete the turn.
+    Notice,
+}
+
+impl ContentFilterAction {
+    pub fn parse(raw: &str) -> Option<Self> {
+        match raw.trim().to_ascii_lowercase().as_str() {
+            "error" => Some(Self::Error),
+            "retry_then_error" => Some(Self::RetryThenError),
+            "retry" => Some(Self::Retry),
+            "notice" => Some(Self::Notice),
+            _ => None,
+        }
+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Error => "error",
+            Self::RetryThenError => "retry_then_error",
+            Self::Retry => "retry",
+            Self::Notice => "notice",
+        }
+    }
+}
+
+/// Env override for `[compat.content_filter] action`.
+pub const GROK_CONTENT_FILTER_ACTION: &str = "GROK_CONTENT_FILTER_ACTION";
+
+/// Resolved content-filter recovery.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ContentFilterConfig {
+    pub action: ContentFilterAction,
+    pub max_retries: u32,
+}
+
+impl Default for ContentFilterConfig {
+    fn default() -> Self {
+        Self {
+            action: ContentFilterAction::RetryThenError,
+            max_retries: 3,
+        }
+    }
+}
+
+impl ContentFilterToml {
+    pub fn resolve(&self) -> ContentFilterConfig {
+        let env_action = std::env::var(GROK_CONTENT_FILTER_ACTION)
+            .ok()
+            .as_deref()
+            .and_then(ContentFilterAction::parse);
+        ContentFilterConfig {
+            action: env_action
+                .or_else(|| self.action.as_deref().and_then(ContentFilterAction::parse))
+                .unwrap_or_default(),
+            max_retries: self.max_retries.filter(|n| *n > 0).unwrap_or(3),
+        }
+    }
+}
+
