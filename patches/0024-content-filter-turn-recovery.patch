@@ -0,0 +1,220 @@
+//! Tests for content-filter stash, recovery modal, and switch/retry.
+
+use super::*;
+use crate::app::dispatch::{
+    CONTENT_FILTER_RETRY_OPTION_ID, CONTENT_FILTER_TURN_MESSAGE, USAGE_LIMIT_SWITCH_MODEL_OPTION_ID,
+};
+
+fn test_stashed_prompt(text: &str) -> crate::app::agent::InFlightPrompt {
+    crate::app::agent::InFlightPrompt {
+        text: text.into(),
+        images: Vec::new(),
+        scrollback_entry: crate::scrollback::EntryId::new(0),
+        combined_scrollback_entries: Vec::new(),
+        chip_elements: Vec::new(),
+    }
+}
+
+fn set_first_selection(
+    qv: &mut crate::views::question_view::QuestionViewState,
+    sel: crate::views::question_view::QuestionSelection,
+) {
+    match qv.selections.first_mut() {
+        Some(slot) => *slot = sel,
+        None => panic!("expected a selection slot"),
+    }
+}
+
+fn complete_content_filter_turn(app: &mut AppView, id: AgentId, prompt_id: Option<String>) {
+    let _ = dispatch(
+        Action::TaskComplete(TaskResult::PromptResponse {
+            agent_id: id,
+            result: Err(CONTENT_FILTER_TURN_MESSAGE.into()),
+            http_status: Some(400),
+            prompt_id,
+        }),
+        app,
+    );
+}
+
+#[test]
+fn content_filter_error_stashes_prompt_and_opens_recovery_modal() {
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let effects = dispatch(Action::SendPrompt("draw me a cat".into()), &mut app);
+    assert!(
+        matches!(effects.first(), Some(Effect::SendPrompt { text, .. }) if text == "draw me a cat")
+    );
+    let prompt_id = test_agent(&app, id).session.current_prompt_id.clone();
+    complete_content_filter_turn(&mut app, id, prompt_id);
+
+    let agent = test_agent(&app, id);
+    assert!(agent.question_view.is_some(), "recovery modal must open");
+    assert!(agent.credit_limit_stashed_prompt.is_none());
+    let stashed = agent
+        .content_filter_stashed_prompt
+        .as_ref()
+        .expect("content-filter prompt must survive finish_turn");
+    assert_eq!(stashed.text, "draw me a cat");
+    let qv = agent.question_view.as_ref().unwrap();
+    assert!(matches!(
+        qv.local_kind,
+        Some(crate::views::question_view::LocalQuestionKind::ContentFilterRecovery)
+    ));
+    let q = qv.questions.first().expect("question");
+    assert_eq!(
+        q.question,
+        "The model provider refused this turn (content filter)."
+    );
+    assert_eq!(q.options.len(), 2);
+    assert_eq!(q.options[0].label, "Switch model & retry");
+    assert_eq!(
+        q.options[0].id.as_deref(),
+        Some(USAGE_LIMIT_SWITCH_MODEL_OPTION_ID)
+    );
+    assert_eq!(q.options[1].label, "Try Again");
+    assert_eq!(
+        q.options[1].id.as_deref(),
+        Some(CONTENT_FILTER_RETRY_OPTION_ID)
+    );
+}
+
+#[test]
+fn generic_turn_error_does_not_stash_content_filter_prompt() {
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let _ = dispatch(Action::SendPrompt("hello".into()), &mut app);
+    let prompt_id = test_agent(&app, id).session.current_prompt_id.clone();
+    let _ = dispatch(
+        Action::TaskComplete(TaskResult::PromptResponse {
+            agent_id: id,
+            result: Err("API error (status 500): boom".into()),
+            http_status: Some(500),
+            prompt_id,
+        }),
+        &mut app,
+    );
+    let agent = test_agent(&app, id);
+    assert!(agent.content_filter_stashed_prompt.is_none());
+    assert!(agent.question_view.is_none());
+}
+
+#[test]
+fn content_filter_try_again_resends_exact_prompt_once() {
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let _ = dispatch(Action::SendPrompt("draw me a cat".into()), &mut app);
+    let prompt_id = test_agent(&app, id).session.current_prompt_id.clone();
+    complete_content_filter_turn(&mut app, id, prompt_id);
+
+    let retry = dispatch(Action::RetryContentFilterPrompt, &mut app);
+    let sends = retry
+        .iter()
+        .filter(|effect| {
+            matches!(
+                effect,
+                Effect::SendPrompt { .. } | Effect::SendPromptBlocks { .. }
+            )
+        })
+        .count();
+    assert_eq!(sends, 1);
+    assert!(retry.iter().any(
+        |effect| matches!(effect, Effect::SendPrompt { text, .. } if text == "draw me a cat")
+    ));
+    let agent = test_agent(&app, id);
+    assert!(agent.content_filter_stashed_prompt.is_none());
+    assert!(agent.credit_limit_stashed_prompt.is_none());
+}
+
+#[test]
+fn content_filter_switch_model_resends_exact_prompt_once() {
+    use crate::app::agent_view::translate_local_submit_for_test;
+    use crate::app::app_view::InputOutcome;
+    use crate::views::question_view::QuestionSelection;
+
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let model_id = acp::ModelId::new(std::sync::Arc::from("content-filter-alternate"));
+    app.agents
+        .get_mut(&id)
+        .unwrap()
+        .session
+        .models
+        .available
+        .insert(
+            model_id.clone(),
+            acp::ModelInfo::new(model_id.clone(), "Content Filter Alternate".to_string()),
+        );
+
+    let _ = dispatch(Action::SendPrompt("draw me a cat".into()), &mut app);
+    let prompt_id = test_agent(&app, id).session.current_prompt_id.clone();
+    complete_content_filter_turn(&mut app, id, prompt_id);
+
+    let mut qv = app
+        .agents
+        .get_mut(&id)
+        .unwrap()
+        .question_view
+        .take()
+        .expect("expected content-filter recovery");
+    set_first_selection(&mut qv, QuestionSelection::Single(Some(0)));
+    let kind = qv.local_kind.take().expect("content-filter local kind");
+    let InputOutcome::Action(open_picker) = translate_local_submit_for_test(&qv, kind, false)
+    else {
+        panic!("expected model-picker action");
+    };
+    assert!(matches!(open_picker, Action::OpenContentFilterModelPicker));
+    assert!(dispatch(open_picker, &mut app).is_empty());
+    assert!(test_agent(&app, id).content_filter_model_retry_pending);
+    assert!(!test_agent(&app, id).credit_limit_model_retry_pending);
+
+    let retry_effects = dispatch(
+        Action::TaskComplete(TaskResult::SwitchModelComplete {
+            agent_id: id,
+            choice: ModelChoice::new(model_id.clone()),
+            result: Ok(()),
+            prev_model_id: None,
+        }),
+        &mut app,
+    );
+    let retry_sends = retry_effects
+        .iter()
+        .filter(|effect| {
+            matches!(
+                effect,
+                Effect::SendPrompt { .. } | Effect::SendPromptBlocks { .. }
+            )
+        })
+        .count();
+    assert_eq!(retry_sends, 1, "switch success must resend exactly once");
+    assert!(retry_effects.iter().any(
+        |effect| matches!(effect, Effect::SendPrompt { text, .. } if text == "draw me a cat")
+    ));
+    let agent = test_agent(&app, id);
+    assert_eq!(agent.session.models.current, Some(model_id));
+    assert!(!agent.content_filter_model_retry_pending);
+    assert!(agent.content_filter_stashed_prompt.is_none());
+}
+
+#[test]
+fn content_filter_retry_does_not_consume_credit_limit_stash() {
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let agent = app.agents.get_mut(&id).unwrap();
+    agent.content_filter_stashed_prompt = Some(test_stashed_prompt("filter me"));
+    agent.credit_limit_stashed_prompt = Some(test_stashed_prompt("billing me"));
+
+    let effects = dispatch(Action::RetryContentFilterPrompt, &mut app);
+    assert!(effects.iter().any(
+        |effect| matches!(effect, Effect::SendPrompt { text, .. } if text == "filter me")
+    ));
+    let agent = test_agent(&app, id);
+    assert!(agent.content_filter_stashed_prompt.is_none());
+    assert_eq!(
+        agent
+            .credit_limit_stashed_prompt
+            .as_ref()
+            .map(|p| p.text.as_str()),
+        Some("billing me")
+    );
+}
