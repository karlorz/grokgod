+#[test]
+fn subagent_model_resolution_gets_its_own_model_tools_lists() {
+    let (_, models) = resolve_models_from_toml(
+        r#"
+        [model."parent-model".tools]
+        deny = ["web_search"]
+
+        [model."child-model".tools]
+        deny = ["grep"]
+        "#,
+        None,
+    );
+
+    let parent_model = models
+        .get("parent-model")
+        .expect("parent model should exist");
+    let child_model = models.get("child-model").expect("child model should exist");
+
+    let mut parent_def = xai_grok_agent::config::AgentDefinition::general_purpose();
+    if let Some(tools) = &parent_model.info.tools {
+        parent_def.merge_model_tools(tools);
+    }
+
+    let mut child_def = xai_grok_agent::config::AgentDefinition::general_purpose();
+    if let Some(tools) = &child_model.info.tools {
+        child_def.merge_model_tools(tools);
+    }
+
+    // Parent has web_search denied, grep allowed
+    assert!(!parent_def.session_tools_allowed("web_search"));
+    assert!(parent_def.session_tools_allowed("grep"));
+
+    // Child has grep denied, web_search allowed
+    assert!(child_def.session_tools_allowed("web_search"));
+    assert!(!child_def.session_tools_allowed("grep"));
+}
