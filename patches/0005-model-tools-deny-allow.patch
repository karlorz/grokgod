+#[test]
+fn model_tools_allow_mode_retains_listed_builtins_and_meta_tools() {
+    use xai_grok_agent::config::ModelToolsConfig;
+
+    let mut def = xai_grok_agent::config::AgentDefinition::general_purpose();
+    let model_tools = ModelToolsConfig {
+        deny: vec![],
+        allow: vec!["read_file".into(), "grep".into()],
+    };
+    def.merge_model_tools(&model_tools);
+
+    assert!(def.session_tools_allowed("read_file"));
+    assert!(def.session_tools_allowed("grep"));
+    assert!(!def.session_tools_allowed("write"));
+    assert!(!def.session_tools_allowed("run_terminal_cmd"));
+    // Meta tools are always allowed in allowlist mode
+    assert!(def.session_tools_allowed("search_tool"));
+    assert!(def.session_tools_allowed("use_tool"));
+}
+
+#[test]
+fn model_tools_deny_wins_when_both_deny_and_allow_present() {
+    use xai_grok_agent::config::ModelToolsConfig;
+
+    let mut def = xai_grok_agent::config::AgentDefinition::general_purpose();
+    let model_tools = ModelToolsConfig {
+        deny: vec!["read_file".into(), "search_tool".into()],
+        allow: vec!["read_file".into(), "grep".into()],
+    };
+    def.merge_model_tools(&model_tools);
+
+    // read_file is in both -> deny wins
+    assert!(!def.session_tools_allowed("read_file"));
+    // grep is only in allow -> allowed
+    assert!(def.session_tools_allowed("grep"));
+    // write is in neither -> not allowed due to allowlist mode
+    assert!(!def.session_tools_allowed("write"));
+    // search_tool explicitly denied -> deny wins even over meta-tool bypass
+    assert!(!def.session_tools_allowed("search_tool"));
+}
