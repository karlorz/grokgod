+#[test]
+fn model_tools_deny_allow_deserializes_onto_model_entry() {
+    let dm = crate::models::default_model();
+    let (_, models) = resolve_models_from_toml(
+        &format!(
+            r#"
+            [model."{dm}".tools]
+            deny = ["web_search", "web_fetch"]
+            allow = ["read_file", "grep"]
+            "#
+        ),
+        None,
+    );
+    let model = models.get(dm).expect("default model should exist");
+    let tools = model
+        .info
+        .tools
+        .as_ref()
+        .expect("tools config should exist");
+    assert_eq!(
+        tools.deny,
+        vec!["web_search".to_string(), "web_fetch".to_string()]
+    );
+    assert_eq!(
+        tools.allow,
+        vec!["read_file".to_string(), "grep".to_string()]
+    );
+}
+
+#[tokio::test]
+async fn model_tools_deny_removes_web_search_and_fetch_from_built_agent() {
+    use std::sync::Arc;
+    use xai_grok_agent::builder::AgentBuilder;
+    use xai_grok_agent::config::ModelToolsConfig;
+    use xai_grok_tools::computer::local::LocalTerminalBackend;
+    use xai_grok_tools::notification::ToolNotificationHandle;
+
+    let mut def = xai_grok_agent::config::AgentDefinition::default_grok_build();
+    let model_tools = ModelToolsConfig {
+        deny: vec!["web_search".into(), "web_fetch".into()],
+        allow: vec![],
+    };
+    def.merge_model_tools(&model_tools);
+
+    let agent = AgentBuilder::new(
+        std::env::temp_dir(),
+        Arc::new(LocalTerminalBackend::new()),
+        ToolNotificationHandle::noop(),
+    )
+    .from_definition(def)
+    .build()
+    .await
+    .unwrap();
+
+    let names: Vec<_> = agent
+        .tool_definitions()
+        .await
+        .iter()
+        .map(|d| d.function.name.clone())
+        .collect();
+
+    assert!(!names.contains(&"web_search".to_string()));
+    assert!(!names.contains(&"web_fetch".to_string()));
+    assert!(names.contains(&"read_file".to_string()));
+}
