+#[test]
+fn model_tools_global_switches_still_dominate_union_semantics() {
+    use xai_grok_agent::config::ModelToolsConfig;
+
+    let mut def = xai_grok_agent::config::AgentDefinition::general_purpose();
+    // Agent / global disallowed_tools
+    def.disallowed_tools = vec!["web_search".into()];
+
+    let model_tools = ModelToolsConfig {
+        deny: vec!["grep".into()],
+        allow: vec![],
+    };
+    def.merge_model_tools(&model_tools);
+
+    assert!(!def.hosted_tool_allowed("web_search"));
+    assert!(!def.session_tools_allowed("grep"));
+    assert!(def.session_tools_allowed("read_file"));
+}
