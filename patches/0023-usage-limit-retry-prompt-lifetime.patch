+fn credit_limit_activity(app: &mut AppView, tool: bool) {
+    let agent = test_agent(app, AgentId(0));
+    let session_id = agent.session.session_id.clone().unwrap();
+    let prompt_id = agent.session.current_prompt_id.clone().unwrap();
+    let update = if tool {
+        acp::SessionUpdate::ToolCall(
+            acp::ToolCall::new("credit-limit-tool", "Read a file")
+                .kind(acp::ToolKind::Read)
+                .status(acp::ToolCallStatus::InProgress),
+        )
+    } else {
+        acp::SessionUpdate::AgentMessageChunk(acp::ContentChunk::new(acp::ContentBlock::Text(
+            acp::TextContent::new("I will inspect the files."),
+        )))
+    };
+    let (response_tx, _rx) = tokio::sync::oneshot::channel();
+    assert!(crate::app::acp_handler::handle(
+        xai_acp_lib::AcpClientMessage::SessionNotification(xai_acp_lib::AcpArgs {
+            request: acp::SessionNotification::new(session_id, update).meta(
+                serde_json::json!({ "promptId": prompt_id })
+                    .as_object()
+                    .cloned()
+            ),
+            response_tx,
+        }),
+        app,
+    ));
+    let agent = test_agent(app, AgentId(0));
+    assert!(agent.session.in_flight_prompt.is_none());
+    assert!(agent.session.usage_limit_retry_prompt.is_some());
+}
+
+fn credit_limit_fail_after_activity(app: &mut AppView, free: bool) {
+    use xai_grok_shell::extensions::notification::{RetryState, SessionUpdate};
+
+    let retry = if free {
+        RetryState::Exhausted {
+            attempts: 2,
+            reason: "status 429: subscription:free-usage-exhausted: all free usage used".into(),
+            is_rate_limited: true,
+        }
+    } else {
+        RetryState::Failed {
+            error_type: "api".into(),
+            message: "API error (status 402 Payment Required): Grok Build usage balance exhausted"
+                .into(),
+        }
+    };
+    let prompt_id = {
+        let agent = app.agents.get_mut(&AgentId(0)).unwrap();
+        crate::app::acp_handler::apply_session_event_for_test(
+            &SessionUpdate::RetryState(retry),
+            &mut agent.session,
+            &mut agent.scrollback,
+        );
+        assert!(agent.session.in_flight_prompt.is_none());
+        assert!(agent.session.usage_limit_retry_prompt.is_some());
+        assert_eq!(agent.session.free_usage_blocked, free);
+        assert_eq!(agent.session.credit_limit_blocked, !free);
+        agent.session.current_prompt_id.clone()
+    };
+    let effects = dispatch(
+        Action::TaskComplete(TaskResult::PromptResponse {
+            agent_id: AgentId(0),
+            result: Err(if free {
+                "rate limited"
+            } else {
+                "balance exhausted"
+            }
+            .into()),
+            http_status: Some(if free { 429 } else { 402 }),
+            prompt_id,
+        }),
+        app,
+    );
+    assert!(!effects.iter().any(|effect| matches!(
+        effect,
+        Effect::SendPrompt { .. } | Effect::SendPromptBlocks { .. }
+    )));
+    let agent = test_agent(app, AgentId(0));
+    assert!(agent.session.state.is_idle());
+    assert!(agent.session.usage_limit_retry_prompt.is_none());
+    assert!(agent.credit_limit_stashed_prompt.is_some());
+}
+
+#[test]
+fn credit_limit_retry_after_assistant_activity_resends_exact_prompt_once() {
+    use crate::app::agent_view::translate_local_submit_for_test;
+    use crate::app::app_view::InputOutcome;
+    use crate::views::question_view::QuestionSelection;
+
+    let mut app = test_app_with_agent();
+    let model = acp::ModelId::new("same-model");
+    app.agents
+        .get_mut(&AgentId(0))
+        .unwrap()
+        .session
+        .models
+        .current = Some(model.clone());
+    let text = "inspect the implementation\nthen continue my original request";
+    let sent = dispatch(Action::SendPrompt(text.into()), &mut app);
+    assert!(
+        matches!(sent.as_slice(), [Effect::SendPrompt { text: payload, .. }] if payload == text)
+    );
+    credit_limit_activity(&mut app, false);
+    credit_limit_fail_after_activity(&mut app, false);
+    assert_eq!(
+        test_agent(&app, AgentId(0))
+            .credit_limit_stashed_prompt
+            .as_ref()
+            .unwrap()
+            .text,
+        text
+    );
+    dispatch(
+        Action::TaskComplete(TaskResult::CreditLimitRecheckComplete {
+            agent_id: AgentId(0),
+            meta: None,
+        }),
+        &mut app,
+    );
+    let mut question = app
+        .agents
+        .get_mut(&AgentId(0))
+        .unwrap()
+        .question_view
+        .take()
+        .unwrap();
+    let retry_index = first_question(&question)
+        .options
+        .iter()
+        .position(|option| option.id.as_deref() == Some(CREDIT_LIMIT_RETRY_OPTION_ID))
+        .unwrap();
+    set_first_selection(&mut question, QuestionSelection::Single(Some(retry_index)));
+    let kind = question.local_kind.take().unwrap();
+    let InputOutcome::Action(retry) = translate_local_submit_for_test(&question, kind, false)
+    else {
+        panic!("Try Again must dispatch an action");
+    };
+    assert!(matches!(retry, Action::RetryCreditLimitPrompt));
+    let effects = dispatch(retry, &mut app);
+    assert_eq!(
+        effects
+            .iter()
+            .filter(|effect| matches!(
+                effect,
+                Effect::SendPrompt { .. } | Effect::SendPromptBlocks { .. }
+            ))
+            .count(),
+        1
+    );
+    assert!(effects.iter().any(|effect| matches!(effect,
+        Effect::SendPrompt { text: payload, .. } if payload == text
+    )));
+    assert_eq!(
+        test_agent(&app, AgentId(0)).session.models.current,
+        Some(model)
+    );
+    assert!(
+        test_agent(&app, AgentId(0))
+            .credit_limit_stashed_prompt
+            .is_none()
+    );
+    assert!(dispatch(Action::RetryCreditLimitPrompt, &mut app).is_empty());
+}
