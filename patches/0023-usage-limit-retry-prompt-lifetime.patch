+#[test]
+fn credit_limit_retry_snapshot_clears_on_completion_failure_cancel_and_reset() {
+    for result in [
+        Ok(acp::PromptResponse::new(acp::StopReason::EndTurn)),
+        Err("ordinary server failure".into()),
+    ] {
+        let mut app = test_app_with_agent();
+        dispatch(Action::SendPrompt("old prompt".into()), &mut app);
+        credit_limit_activity(&mut app, false);
+        let prompt_id = test_agent(&app, AgentId(0))
+            .session
+            .current_prompt_id
+            .clone();
+        dispatch(
+            Action::TaskComplete(TaskResult::PromptResponse {
+                agent_id: AgentId(0),
+                result,
+                http_status: None,
+                prompt_id,
+            }),
+            &mut app,
+        );
+        assert!(
+            test_agent(&app, AgentId(0))
+                .session
+                .usage_limit_retry_prompt
+                .is_none()
+        );
+        assert!(
+            test_agent(&app, AgentId(0))
+                .credit_limit_stashed_prompt
+                .is_none()
+        );
+        dispatch(Action::SendPrompt("next prompt".into()), &mut app);
+        assert_eq!(
+            test_agent(&app, AgentId(0))
+                .session
+                .usage_limit_retry_prompt
+                .as_ref()
+                .unwrap()
+                .text,
+            "next prompt"
+        );
+    }
+    let mut app = test_app_with_agent();
+    dispatch(Action::SendPrompt("cancel me".into()), &mut app);
+    credit_limit_activity(&mut app, false);
+    let prompt_id = test_agent(&app, AgentId(0))
+        .session
+        .current_prompt_id
+        .clone();
+    let effects = dispatch(Action::CancelTurn, &mut app);
+    assert!(
+        effects
+            .iter()
+            .any(|effect| matches!(effect, Effect::CancelTurn { .. }))
+    );
+    assert!(
+        test_agent(&app, AgentId(0))
+            .session
+            .usage_limit_retry_prompt
+            .is_none()
+    );
+    dispatch(
+        Action::TaskComplete(TaskResult::PromptResponse {
+            agent_id: AgentId(0),
+            result: Err("status 402: balance exhausted".into()),
+            http_status: Some(402),
+            prompt_id,
+        }),
+        &mut app,
+    );
+    assert!(
+        test_agent(&app, AgentId(0))
+            .credit_limit_stashed_prompt
+            .is_none()
+    );
+    let agent = app.agents.get_mut(&AgentId(0)).unwrap();
+    agent
+        .session
+        .capture_in_flight_prompt(test_stashed_prompt("old turn"));
+    agent.begin_local_turn("replacement");
+    assert!(agent.session.usage_limit_retry_prompt.is_none());
+    agent
+        .session
+        .capture_in_flight_prompt(test_stashed_prompt("old reload"));
+    agent.begin_session_reload(1);
+    assert!(agent.session.usage_limit_retry_prompt.is_none());
+    agent
+        .session
+        .capture_in_flight_prompt(test_stashed_prompt("old binding"));
+    agent.bind_session_id(acp::SessionId::new("replacement-session"));
+    assert!(agent.session.usage_limit_retry_prompt.is_none());
+    agent
+        .session
+        .capture_in_flight_prompt(test_stashed_prompt("unbound turn"));
+    agent.unbind_session_id();
+    assert!(agent.session.usage_limit_retry_prompt.is_none());
+}
