+#[test]
+fn credit_limit_adopted_prompt_captures_both_plain_and_combined_payloads() {
+    for segments in [None, Some(vec!["alpha".into(), "beta".into()])] {
+        let mut app = test_app_with_agent();
+        let agent = app.agents.get_mut(&AgentId(0)).unwrap();
+        let text = if segments.is_some() {
+            "alpha\n\nbeta"
+        } else {
+            "alpha"
+        };
+        crate::app::dispatch::queue::apply_turn_start_shim(
+            agent,
+            "adopted-prompt".into(),
+            Some(text.into()),
+            "prompt",
+            segments.clone(),
+        );
+        let retained = agent.session.usage_limit_retry_prompt.as_ref().unwrap();
+        assert_eq!(retained.text, text);
+        assert_eq!(
+            retained.combined_scrollback_entries.len(),
+            usize::from(segments.is_some())
+        );
+    }
+}
