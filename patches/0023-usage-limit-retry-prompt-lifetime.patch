+#[test]
+fn credit_limit_tool_activity_autocompact_retains_combined_images_and_chips() {
+    use crate::app::agent::{ChipElement, QueueEntryKind, QueuedPrompt};
+    use xai_grok_shell::extensions::notification::SessionUpdate;
+
+    let mut app = test_app_with_agent();
+    let text = "first segment\n\nlook [Image #1]";
+    let image = crate::prompt_images::from_clipboard_data(&crate::clipboard::ImageData {
+        data: vec![1, 2, 3],
+        mime_type: "image/png".into(),
+    });
+    let chip = ChipElement {
+        range: 20..30,
+        kind: crate::views::prompt_widget::KIND_IMAGE,
+        display: Some(ratatui::text::Line::from("Image attachment")),
+    };
+    {
+        let agent = app.agents.get_mut(&AgentId(0)).unwrap();
+        let queue_id = agent.session.enqueue_prompt(text.into());
+        let queued = agent.session.pending_prompts.back_mut().unwrap();
+        *queued = QueuedPrompt {
+            images: vec![image.clone()],
+            chip_elements: vec![chip.clone()],
+            combined_texts: vec!["first segment".into(), "look [Image #1]".into()],
+            ..QueuedPrompt::plain(queue_id, text, QueueEntryKind::Prompt)
+        };
+    }
+    let effects = dispatch(Action::DrainQueue, &mut app);
+    assert!(
+        effects
+            .iter()
+            .any(|effect| matches!(effect, Effect::SendPromptBlocks { .. }))
+    );
+    let original = test_agent(&app, AgentId(0))
+        .session
+        .usage_limit_retry_prompt
+        .clone()
+        .unwrap();
+    assert_eq!(original.combined_scrollback_entries.len(), 1);
+    credit_limit_activity(&mut app, true);
+    {
+        let agent = app.agents.get_mut(&AgentId(0)).unwrap();
+        for update in [
+            SessionUpdate::AutoCompactStarted {
+                tokens_used: 180_000,
+                context_window: 200_000,
+                percentage: 90,
+                reason: "threshold".into(),
+            },
+            SessionUpdate::AutoCompactCompleted {
+                tokens_before: Some(180_000),
+                tokens_after: 40_000,
+                elapsed_ms: Some(20),
+                compaction_round_count: 1,
+                compaction_round_warning_limit: 3,
+                summary_preview: None,
+            },
+        ] {
+            crate::app::acp_handler::apply_session_event_for_test(
+                &update,
+                &mut agent.session,
+                &mut agent.scrollback,
+            );
+        }
+        assert!(agent.session.in_flight_prompt.is_none());
+        assert!(agent.session.compact_held_prompt.is_none());
+    }
+    credit_limit_fail_after_activity(&mut app, false);
+    let stashed = test_agent(&app, AgentId(0))
+        .credit_limit_stashed_prompt
+        .as_ref()
+        .unwrap();
+    assert_eq!(stashed.text, text);
+    assert_eq!(stashed.scrollback_entry, original.scrollback_entry);
+    assert_eq!(
+        stashed.combined_scrollback_entries,
+        original.combined_scrollback_entries
+    );
+    assert_eq!(stashed.images[0].encoded_bytes, image.encoded_bytes);
+    assert_eq!(stashed.images[0].mime_type, image.mime_type);
+    assert_eq!(stashed.chip_elements[0].range, chip.range);
+    assert_eq!(stashed.chip_elements[0].kind, chip.kind);
+    assert_eq!(stashed.chip_elements[0].display, chip.display);
+    let retry = dispatch(Action::RetryCreditLimitPrompt, &mut app);
+    assert_eq!(
+        retry
+            .iter()
+            .filter(|effect| matches!(
+                effect,
+                Effect::SendPrompt { .. } | Effect::SendPromptBlocks { .. }
+            ))
+            .count(),
+        1
+    );
+    assert!(
+        retry
+            .iter()
+            .any(|effect| matches!(effect, Effect::SendPromptBlocks { .. }))
+    );
+    let retained = test_agent(&app, AgentId(0))
+        .session
+        .usage_limit_retry_prompt
+        .as_ref()
+        .unwrap();
+    assert_eq!(retained.text, text);
+    assert_eq!(retained.images[0].encoded_bytes, image.encoded_bytes);
+    assert_eq!(retained.chip_elements[0].display, chip.display);
+}
