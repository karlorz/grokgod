+#[test]
+fn test_tool_image_hoisting_request_conversion() {
+    let tool_item = ConversationItem::tool_result_with_images(
+        "call_1",
+        "Tool output text",
+        vec![ContentPart::Image {
+            url: "data:image/png;base64,img1".into(),
+        }],
+    );
+
+    // 1. Empty or ["text"] input_modalities leaves tool image on role=tool
+    for modalities in [vec![], vec!["text".to_string()]] {
+        let req = ConversationRequest {
+            items: vec![
+                ConversationItem::user("user message"),
+                tool_item.clone(),
+            ],
+            input_modalities: modalities,
+            ..Default::default()
+        };
+        let chat_req: ChatCompletionRequest = req.into();
+        assert_eq!(chat_req.messages.len(), 2);
+        assert_eq!(chat_req.messages[0].role, Role::User);
+        assert_eq!(chat_req.messages[1].role, Role::Tool);
+        assert_eq!(chat_req.messages[1].tool_call_id, Some("call_1".to_string()));
+        let MessageContent::Blocks(blocks) = &chat_req.messages[1].content else {
+            panic!("expected Blocks in tool message");
+        };
+        assert_eq!(blocks.len(), 2);
+        assert!(matches!(&blocks[0], ChatContentBlock::Text { text } if text == "Tool output text"));
+        assert!(matches!(&blocks[1], ChatContentBlock::ImageUrl { image_url } if image_url.url == "data:image/png;base64,img1"));
+    }
+
+    // 2. ["text", "image"] hoists one tool image to a following user message with the exact lead-in
+    {
+        let req = ConversationRequest {
+            items: vec![
+                ConversationItem::user("user message"),
+                tool_item.clone(),
+            ],
+            input_modalities: vec!["text".to_string(), "image".to_string()],
+            ..Default::default()
+        };
+        let chat_req: ChatCompletionRequest = req.into();
+        assert_eq!(chat_req.messages.len(), 3);
+        assert_eq!(chat_req.messages[0].role, Role::User);
+        assert_eq!(chat_req.messages[1].role, Role::Tool);
+        assert_eq!(chat_req.messages[1].tool_call_id, Some("call_1".to_string()));
+        assert_eq!(chat_req.messages[1].text_content(), "Tool output text");
+
+        assert_eq!(chat_req.messages[2].role, Role::User);
+        let MessageContent::Blocks(user_blocks) = &chat_req.messages[2].content else {
+            panic!("expected Blocks in hoisted user message");
+        };
+        assert_eq!(user_blocks.len(), 2);
+        assert!(matches!(&user_blocks[0], ChatContentBlock::Text { text } if text == "Attached image(s) from tool result:"));
+        assert!(matches!(&user_blocks[1], ChatContentBlock::ImageUrl { image_url } if image_url.url == "data:image/png;base64,img1"));
+    }
+
+    // 3. Two tool images in one run become one user message
+    {
+        let tool_item_2 = ConversationItem::tool_result_with_images(
+            "call_2",
+            "Tool output 2",
+            vec![ContentPart::Image {
+                url: "data:image/png;base64,img2".into(),
+            }],
+        );
+        let req = ConversationRequest {
+            items: vec![
+                ConversationItem::user("user message"),
+                tool_item.clone(),
+                tool_item_2,
+            ],
+            input_modalities: vec!["text".to_string(), "IMAGE".to_string()],
+            ..Default::default()
+        };
+        let chat_req: ChatCompletionRequest = req.into();
+        assert_eq!(chat_req.messages.len(), 4);
+        assert_eq!(chat_req.messages[0].role, Role::User);
+        assert_eq!(chat_req.messages[1].role, Role::Tool);
+        assert_eq!(chat_req.messages[2].role, Role::Tool);
+        assert_eq!(chat_req.messages[3].role, Role::User);
+
+        let MessageContent::Blocks(user_blocks) = &chat_req.messages[3].content else {
+            panic!("expected Blocks in hoisted user message");
+        };
+        assert_eq!(user_blocks.len(), 3);
+        assert!(matches!(&user_blocks[0], ChatContentBlock::Text { text } if text == "Attached image(s) from tool result:"));
+        assert!(matches!(&user_blocks[1], ChatContentBlock::ImageUrl { image_url } if image_url.url == "data:image/png;base64,img1"));
+        assert!(matches!(&user_blocks[2], ChatContentBlock::ImageUrl { image_url } if image_url.url == "data:image/png;base64,img2"));
+    }
+
+    // 4. Two separated runs become two user messages
+    {
+        let tool_item_b = ConversationItem::tool_result_with_images(
+            "call_b",
+            "Tool output b",
+            vec![ContentPart::Image {
+                url: "data:image/png;base64,img_b".into(),
+            }],
+        );
+        let req = ConversationRequest {
+            items: vec![
+                ConversationItem::user("user message 1"),
+                tool_item.clone(),
+                ConversationItem::assistant("assistant intervening"),
+                tool_item_b,
+            ],
+            input_modalities: vec!["text".to_string(), "image".to_string()],
+            ..Default::default()
+        };
+        let chat_req: ChatCompletionRequest = req.into();
+        assert_eq!(chat_req.messages.len(), 6);
+        assert_eq!(chat_req.messages[0].role, Role::User);
+        assert_eq!(chat_req.messages[1].role, Role::Tool);
+        assert_eq!(chat_req.messages[2].role, Role::User); // hoisted for first run
+        assert_eq!(chat_req.messages[3].role, Role::Assistant);
+        assert_eq!(chat_req.messages[4].role, Role::Tool);
+        assert_eq!(chat_req.messages[5].role, Role::User); // hoisted for second run
+    }
+
+    // 5. An existing user image stays put
+    {
+        let user_img = ConversationItem::User(UserItem {
+            content: vec![
+                ContentPart::Text { text: "user prompt".into() },
+                ContentPart::Image { url: "data:image/png;base64,user_img".into() },
+            ],
+            ..Default::default()
+        });
+        let req = ConversationRequest {
+            items: vec![
+                user_img,
+                tool_item,
+            ],
+            input_modalities: vec!["text".to_string(), "image".to_string()],
+            ..Default::default()
+        };
+        let chat_req: ChatCompletionRequest = req.into();
+        assert_eq!(chat_req.messages.len(), 3);
+        assert_eq!(chat_req.messages[0].role, Role::User);
+        let MessageContent::Blocks(u_blocks) = &chat_req.messages[0].content else {
+            panic!("expected blocks in original user message");
+        };
+        assert_eq!(u_blocks.len(), 2);
+        assert!(matches!(&u_blocks[0], ChatContentBlock::Text { text } if text == "user prompt"));
+        assert!(matches!(&u_blocks[1], ChatContentBlock::ImageUrl { image_url } if image_url.url == "data:image/png;base64,user_img"));
+
+        assert_eq!(chat_req.messages[1].role, Role::Tool);
+        assert_eq!(chat_req.messages[2].role, Role::User);
+    }
+}
