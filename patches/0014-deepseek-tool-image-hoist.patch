+/// When the model supports image input modalities, hoists images from contiguous runs of tool messages
+/// into an immediately following synthetic user message.
+fn hoist_tool_images(messages: Vec<ChatRequestMessage>) -> Vec<ChatRequestMessage> {
+    let has_tool_image = messages.iter().any(|m| {
+        m.role == Role::Tool
+            && match &m.content {
+                MessageContent::Blocks(blocks) => blocks
+                    .iter()
+                    .any(|b| matches!(b, ChatContentBlock::ImageUrl { .. })),
+                MessageContent::Text(_) => false,
+            }
+    });
+
+    if !has_tool_image {
+        return messages;
+    }
+
+    let mut out: Vec<ChatRequestMessage> = Vec::with_capacity(messages.len() + 2);
+    let mut hoisted_images: Vec<ChatContentBlock> = Vec::new();
+
+    let mut flush_hoisted = |out: &mut Vec<ChatRequestMessage>, hoisted: &mut Vec<ChatContentBlock>| {
+        if !hoisted.is_empty() {
+            let mut user_blocks = Vec::with_capacity(1 + hoisted.len());
+            user_blocks.push(ChatContentBlock::Text {
+                text: "Attached image(s) from tool result:".to_string(),
+            });
+            user_blocks.append(hoisted);
+            out.push(ChatRequestMessage {
+                role: Role::User,
+                content: MessageContent::Blocks(user_blocks),
+                name: None,
+                tool_calls: Vec::new(),
+                tool_call_id: None,
+                model_id: None,
+                reasoning_content: None,
+            });
+        }
+    };
+
+    for mut msg in messages {
+        if msg.role == Role::Tool {
+            if let MessageContent::Blocks(blocks) = msg.content {
+                let mut kept_blocks: Vec<ChatContentBlock> = Vec::with_capacity(blocks.len());
+                for block in blocks {
+                    match block {
+                        ChatContentBlock::ImageUrl { .. } => {
+                            hoisted_images.push(block);
+                        }
+                        other => {
+                            kept_blocks.push(other);
+                        }
+                    }
+                }
+                if kept_blocks.len() == 1
+                    && matches!(kept_blocks.first(), Some(ChatContentBlock::Text { .. }))
+                {
+                    if let Some(ChatContentBlock::Text { text }) = kept_blocks.pop() {
+                        msg.content = MessageContent::Text(text);
+                    }
+                } else {
+                    msg.content = MessageContent::Blocks(kept_blocks);
+                }
+            }
+            out.push(msg);
+        } else {
+            flush_hoisted(&mut out, &mut hoisted_images);
+            out.push(msg);
+        }
+    }
+
+    flush_hoisted(&mut out, &mut hoisted_images);
+    out
+}
