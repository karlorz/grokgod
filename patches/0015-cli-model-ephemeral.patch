+#[test]
+fn switch_model_complete_skips_persist_for_cli_model_once() {
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let model_id = acp::ModelId::new(std::sync::Arc::from("flash-max"));
+    app.cli_model_override = Some(model_id.clone());
+    app.cli_model_ephemeral = true;
+
+    let agent = app.agents.get_mut(&id).unwrap();
+    agent.session.models.available.insert(
+        model_id.clone(),
+        acp::ModelInfo::new(model_id.clone(), "flash-max".to_string()),
+    );
+    agent.session.model_switch_pending = true;
+
+    let effects = dispatch(
+        Action::TaskComplete(TaskResult::SwitchModelComplete {
+            agent_id: id,
+            model_id: model_id.clone(),
+            effort: None,
+            result: Ok(()),
+            prev_model_id: None,
+        }),
+        &mut app,
+    );
+
+    assert!(
+        !effects
+            .iter()
+            .any(|e| matches!(e, Effect::PersistPreferredModel { .. })),
+        "startup -m must not write the saved default"
+    );
+    assert!(!app.cli_model_ephemeral);
+    assert_eq!(
+        expect_agent(&app, id).session.models.current,
+        Some(model_id.clone())
+    );
+
+    app.agents.get_mut(&id).unwrap().session.models.current = None;
+    app.agents.get_mut(&id).unwrap().session.model_switch_pending = true;
+    let again = dispatch(
+        Action::TaskComplete(TaskResult::SwitchModelComplete {
+            agent_id: id,
+            model_id: model_id.clone(),
+            effort: None,
+            result: Ok(()),
+            prev_model_id: None,
+        }),
+        &mut app,
+    );
+    assert!(
+        again
+            .iter()
+            .any(|e| matches!(e, Effect::PersistPreferredModel { .. })),
+        "a later switch to the same id still saves"
+    );
+}
