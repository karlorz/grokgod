+/// `[plan_mode]` TOML table. Extra writable markdown globs and the
+/// implement-via-subagents reminder (default on). `None` fields fall through
+/// to client defaults in the shell resolver.
+#[derive(Debug, Clone, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(default)]
+pub struct PlanModeSettings {
+    /// Glob list matched against the absolute edit path while plan mode is
+    /// Active. `None` ⇒ client default catalog. `Some([])` ⇒ no extra paths
+    /// (session plan file only). Non-empty replaces the catalog.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub extra_writable_globs: Option<Vec<String>>,
+    /// When `Some(false)`, stock “start coding” messages. Absent/`true` ⇒
+    /// second-tier implementer subagents with parent verification.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub implement_via_subagents: Option<bool>,
+}
+
+impl PlanModeSettings {
+    /// Default extra-path catalog when `extra_writable_globs` is absent.
+    pub const DEFAULT_EXTRA_WRITABLE_GLOBS: &'static [&'static str] = &[
+        "**/projects/*/work/*/*.md",
+        "**/docs/superpowers/**/*.md",
+    ];
+
+    /// `None` → default catalog. `Some([])` → no extra paths. Non-empty replaces.
+    pub fn resolved_extra_writable_globs(&self) -> Vec<String> {
+        match &self.extra_writable_globs {
+            None => Self::DEFAULT_EXTRA_WRITABLE_GLOBS
+                .iter()
+                .map(|s| (*s).to_string())
+                .collect(),
+            Some(v) => v.clone(),
+        }
+    }
+
+    /// Absent or `true` → implement-via-subagents reminders. `Some(false)` opts out.
+    pub fn resolved_implement_via_subagents(&self) -> bool {
+        self.implement_via_subagents.unwrap_or(true)
+    }
+}
