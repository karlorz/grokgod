+fn compile_extra_writable_set(globs: &[String]) -> globset::GlobSet {
+    let mut builder = globset::GlobSetBuilder::new();
+    for pattern in globs {
+        if let Ok(glob) = globset::Glob::new(pattern) {
+            builder.add(glob);
+        }
+    }
+    builder
+        .build()
+        .unwrap_or_else(|_| globset::GlobSetBuilder::new().build().expect("empty globset"))
+}
+fn extra_writable_set_matches(target_path: &Path, set: &globset::GlobSet) -> bool {
+    if set.is_empty() {
+        return false;
+    }
+    let normalized = if cfg!(windows) {
+        target_path.to_string_lossy().replace('\\', "/")
+    } else {
+        target_path.to_string_lossy().into_owned()
+    };
+    set.is_match(normalized)
+}
+/// True when `target_path` matches any extra writable glob (slash-normalized).
+pub(crate) fn is_extra_writable_plan_path(target_path: &Path, globs: &[String]) -> bool {
+    if globs.is_empty() {
+        return false;
+    }
+    extra_writable_set_matches(target_path, &compile_extra_writable_set(globs))
+}
