+    /// DeepSeek/Poe/CPA Chat Completions usage trailers emit JSON null for
+    /// integer detail fields. OpenAI types these as integer default 0.
+    #[test]
+    fn test_chat_completion_chunk_deserializes_null_usage_detail_ints() {
+        let json = r#"{
+            "id":"chatcmpl-aaaaaaaaaaaa",
+            "object":"chat.completion.chunk",
+            "created":1756622681,
+            "model":"deepseek-v4-flash",
+            "choices":[{"index":0,"delta":{},"finish_reason":"stop"}],
+            "usage":{
+                "prompt_tokens":111111,
+                "completion_tokens":11111,
+                "total_tokens":111111,
+                "prompt_tokens_details":{"cached_tokens":null},
+                "completion_tokens_details":{"reasoning_tokens":null}
+            }
+        }"#;
+
+        let chunk: ChatCompletionChunk =
+            serde_json::from_str(json).expect("null usage ints should deserialize as 0");
+        let usage = chunk.usage.expect("usage present");
+        assert_eq!(usage.prompt_tokens, 111111);
+        assert_eq!(
+            usage
+                .prompt_tokens_details
+                .as_ref()
+                .map(|d| d.cached_tokens),
+            Some(0)
+        );
+        assert_eq!(
+            usage
+                .completion_tokens_details
+                .as_ref()
+                .map(|d| d.reasoning_tokens),
+            Some(0)
+        );
+    }
+
