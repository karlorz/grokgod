+                xai_tool_runtime::Tool::run(
+                    &tool,
+                    test_ctx_with_call_id(shared, "tc-rec"),
+                    input,
+                )
+                .await
+            }
+        });
+
+        let _request = rx.recv().await.expect("should receive request");
+        tokio::time::advance(std::time::Duration::from_secs(6)).await;
+
+        let result = handle.await.unwrap().unwrap();
+        match result {
+            AskUserQuestionOutput::UserAnswered { message } => {
+                assert_eq!(
+                    message,
+                    format::timeout_recommended_text(&[make_question(
+                        "Approve?",
+                        &["Yes — implement now (Recommended)", "Stop"],
+                    )])
