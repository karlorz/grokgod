+// ── Timeout + recommended (grokgod timeout_action) ──────────────────────
+
+/// Honest prefix when timeout auto-selects the recommended option. Must not
+/// claim the user answered (`format_accepted_tool_result`).
+pub const TIMEOUT_RECOMMENDED_PREFIX: &str =
+    "Ask-Question timed out; auto-selected recommended";
+
+/// Labels timeout should auto-select.
+///
+/// Single-select: first `(Recommended)`, else the first option.
+/// Multi-select: every `(Recommended)` label; if none, the first option only.
+pub fn recommended_labels(options: &[QuestionOption], multi_select: bool) -> Vec<&str> {
+    let marked: Vec<&str> = options
+        .iter()
+        .filter(|o| o.label.contains("(Recommended)"))
+        .map(|o| o.label.as_str())
+        .collect();
+    if !marked.is_empty() {
+        if multi_select {
+            return marked;
+        }
+        return marked.into_iter().take(1).collect();
+    }
+    options
+        .first()
+        .map(|o| o.label.as_str())
+        .into_iter()
+        .collect()
+}
+
+/// First option whose label contains `(Recommended)`, else the first option.
+pub fn recommended_label(options: &[QuestionOption]) -> Option<&str> {
+    recommended_labels(options, false).into_iter().next()
+}
+
+/// Tool result for timeout + `timeout_action = "recommended"`. Questions with
+/// no options are omitted; if none remain, official cancel text is used.
+pub fn timeout_recommended_text(questions: &[Question]) -> String {
+    let entries: Vec<String> = questions
+        .iter()
+        .filter_map(|q| {
+            let labels = recommended_labels(&q.options, q.multi_select.unwrap_or(false));
+            if labels.is_empty() {
+                return None;
+            }
+            Some(format!("\"{}\"=\"{}\"", q.question, labels.join(", ")))
+        })
+        .collect();
+    if entries.is_empty() {
+        return CANCEL_TEXT.to_string();
+    }
+    format!(
+        "{TIMEOUT_RECOMMENDED_PREFIX}: {}. Continue with that choice.",
+        entries.join(", ")
+    )
+}
+
