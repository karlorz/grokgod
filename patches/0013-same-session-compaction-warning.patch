+/// Build the session warning for a completed auto-compaction count.
+pub(crate) fn compaction_warning_message(
+    round_count: u64,
+    warning_limit: u64,
+) -> Option<String> {
+    if warning_limit == 0 {
+        return None;
+    }
+    if round_count == warning_limit {
+        Some(format!(
+            "Compacted {round_count} times in this session. Save SkillWiki progress soon."
+        ))
+    } else if round_count >= warning_limit.saturating_add(1) {
+        Some(format!(
+            "Compacted {round_count} times in this session. Save SkillWiki progress and hand off to a new session."
+        ))
+    } else {
+        None
+    }
+}
