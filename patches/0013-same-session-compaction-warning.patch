+pub(crate) const DEFAULT_COMPACTION_ROUND_WARNING_LIMIT: u64 = 3;
+const ENV_COMPACTION_ROUND_WARNING_LIMIT: &str = "GROK_COMPACTION_ROUND_WARNING_LIMIT";
+
+fn resolve_compaction_round_warning_limit_from(
+    env: Option<&str>,
+    config: Option<u64>,
+) -> u64 {
+    let from_env = env.and_then(|raw| match raw.trim().parse::<u64>() {
+        Ok(value) => Some(value),
+        Err(error) => {
+            tracing::debug!(
+                value = raw,
+                error = %error,
+                "invalid GROK_COMPACTION_ROUND_WARNING_LIMIT; ignoring"
+            );
+            None
+        }
+    });
+
+    from_env
+        .or(config)
+        .unwrap_or(DEFAULT_COMPACTION_ROUND_WARNING_LIMIT)
+}
+
+pub(crate) fn resolve_compaction_round_warning_limit(config: Option<u64>) -> u64 {
+    let env = std::env::var(ENV_COMPACTION_ROUND_WARNING_LIMIT).ok();
+    resolve_compaction_round_warning_limit_from(env.as_deref(), config)
+}
+
+#[cfg(test)]
+mod compaction_round_warning_limit_tests {
+    use super::{
+        resolve_compaction_round_warning_limit_from as resolve,
+        DEFAULT_COMPACTION_ROUND_WARNING_LIMIT,
+    };
+
+    #[test]
+    fn default_without_env_or_config() {
+        assert_eq!(resolve(None, None), DEFAULT_COMPACTION_ROUND_WARNING_LIMIT);
+    }
+
+    #[test]
+    fn config_is_used_without_env() {
+        assert_eq!(resolve(None, Some(7)), 7);
+    }
+
+    #[test]
+    fn zero_is_accepted() {
+        assert_eq!(resolve(None, Some(0)), 0);
+        assert_eq!(resolve(Some("0"), Some(7)), 0);
+    }
+
+    #[test]
+    fn env_takes_precedence_over_config() {
+        assert_eq!(resolve(Some("9"), Some(7)), 9);
+    }
+
+    #[test]
+    fn malformed_env_falls_through() {
+        assert_eq!(resolve(Some("not-a-number"), Some(7)), 7);
+        assert_eq!(resolve(Some("not-a-number"), None), DEFAULT_COMPACTION_ROUND_WARNING_LIMIT);
+    }
+}
+
