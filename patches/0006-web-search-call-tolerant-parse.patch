+    /// Test 1: output_item.added with web_search_call missing action (exact probe frame).
+    /// Deserializes successfully and item survives with default Search action.
+    #[test]
+    fn deserialize_response_event_tolerates_output_item_added_missing_action() {
+        let sse = r#"{"type":"response.output_item.added","item":{"id":"ws_0d946a02bfcb6104016a91a4d9505c87d0b6389a02828c70cf","type":"web_search_call","status":"in_progress"},"output_index":1,"sequence_number":8}"#;
+        let event = deserialize_response_event(sse).expect("probe fixture should deserialize");
+        let rs::ResponseStreamEvent::ResponseOutputItemAdded(added) = event else {
+            panic!("expected ResponseOutputItemAdded");
+        };
+        let rs::OutputItem::WebSearchCall(ws) = added.item else {
+            panic!("expected WebSearchCall");
+        };
+        assert_eq!(
+            ws.id,
+            "ws_0d946a02bfcb6104016a91a4d9505c87d0b6389a02828c70cf"
+        );
+        assert_eq!(ws.status, rs::WebSearchToolCallStatus::InProgress);
+        let rs::WebSearchToolCallAction::Search(search) = ws.action else {
+            panic!("expected Search action");
+        };
+        assert_eq!(search.query, "");
+    }
