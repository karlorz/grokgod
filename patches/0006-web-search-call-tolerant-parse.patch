+/// Try injecting a default action into search call items missing `action`.
+///
+/// Handles `web_search_call` and `x_search_call` items where upstream
+/// omits `action` on in-progress / done frames or in terminal outputs.
+fn sanitize_search_call_action(item: &mut serde_json::Value) {
+    if let Some(obj) = item.as_object_mut() {
+        let is_search_call = obj
+            .get("type")
+            .and_then(|t| t.as_str())
+            .map(|t| t == "web_search_call" || t == "x_search_call")
+            .unwrap_or(false);
+        if is_search_call && !obj.contains_key("action") {
+            obj.insert(
+                "action".to_string(),
+                serde_json::json!({ "type": "search", "query": "" }),
+            );
+        }
+    }
+}
