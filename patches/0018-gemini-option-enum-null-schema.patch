+                            "{tool_name} advertised an invalid enum: {values:?}"
+                        );
+                    }
+                    for value in object.values() {
+                        assert_all_enum_members_are_non_empty_strings(tool_name, value);
+                    }
+                }
+                serde_json::Value::Array(values) => {
+                    for value in values {
+                        assert_all_enum_members_are_non_empty_strings(tool_name, value);
+                    }
+                }
+                _ => {}
+            }
+        }
+        for definition in &definitions {
+            assert_all_enum_members_are_non_empty_strings(
+                &definition.function.name,
+                &definition.function.parameters,
