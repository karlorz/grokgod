+/// Gemini-compatible JSON Schema enum cleanup. Some generators include the
+/// nullable branch (`null`) inside an enum for `Option<Enum>` fields. Keep
+/// nullability in `type`, but advertise only non-empty string enum members.
+/// Remove an enum keyword entirely when no valid members remain.
+fn sanitize_enum_arrays(value: &mut serde_json::Value) {
+    match value {
+        serde_json::Value::Object(object) => {
+            let remove_enum = if let Some(serde_json::Value::Array(values)) = object.get_mut("enum")
+            {
+                values.retain(|value| value.as_str().is_some_and(|value| !value.is_empty()));
+                values.is_empty()
+            } else {
+                false
+            };
+            if remove_enum {
+                object.remove("enum");
+            }
+            for value in object.values_mut() {
+                sanitize_enum_arrays(value);
+            }
+        }
+        serde_json::Value::Array(values) => {
+            for value in values {
+                sanitize_enum_arrays(value);
+            }
+        }
+        _ => {}
+    }
+}
