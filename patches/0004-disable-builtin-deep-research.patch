+#[test]
+fn set_workflow_builtin_deep_research_patches_open_extensions_modal() {
+    use crate::views::extensions_modal::{
+        ExtensionsModalState, ExtensionsTab, TabDataState, WorkflowInfo,
+    };
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let mut modal = ExtensionsModalState::new(ExtensionsTab::Workflows);
+    modal.workflows_data = TabDataState::Loaded(vec![
+        WorkflowInfo {
+            name: "deep-research".into(),
+            description: "Deep research".into(),
+            when_to_use: None,
+            source: "builtin".into(),
+            path: None,
+            enabled: true,
+        },
+        WorkflowInfo {
+            name: "user-wf".into(),
+            description: "User wf".into(),
+            when_to_use: None,
+            source: "user".into(),
+            path: None,
+            enabled: true,
+        },
+    ]);
+    modal.pending_action = Some("toggling...".into());
+    modal.pending_entry_index = Some(0);
+    app.agents.get_mut(&id).unwrap().extensions_modal = Some(modal);
+
+    let effects = dispatch(Action::SetWorkflowBuiltinDeepResearch(false), &mut app);
+    assert_eq!(effects.len(), 1);
+    match &effects[0] {
+        Effect::PersistSetting {
+            key,
+            value,
+            rollback_value,
+        } => {
+            assert_eq!(*key, "workflows.builtins.deep-research");
+            assert_eq!(*value, crate::settings::SettingValue::Bool(false));
+            assert_eq!(*rollback_value, crate::settings::SettingValue::Bool(true));
+        }
+        other => panic!("expected PersistSetting, got {other:?}"),
+    }
+
+    let agent = app.agents.get(&id).unwrap();
+    let modal = agent.extensions_modal.as_ref().unwrap();
+    assert!(modal.pending_action.is_none());
+    assert!(modal.pending_entry_index.is_none());
+    if let TabDataState::Loaded(ref workflows) = modal.workflows_data {
+        assert_eq!(workflows[0].name, "deep-research");
+        assert_eq!(workflows[0].enabled, false);
+        assert_eq!(workflows[1].name, "user-wf");
+        assert_eq!(workflows[1].enabled, true);
+    } else {
+        panic!("expected TabDataState::Loaded");
+    }
+}
