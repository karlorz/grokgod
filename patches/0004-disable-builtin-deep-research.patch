+#[test]
+fn builtin_deep_research_disabled_allows_unique_skill_to_own_bare_name() {
+    let skill = make_plugin_skill("deep-research", "deep-research");
+    let availability_off = CommandAvailability {
+        builtin_deep_research: false,
+        ..CommandAvailability::all_enabled()
+    };
+    let commands = available_commands(&[skill.clone()], availability_off, &[]);
+    let dr_cmds: Vec<_> = commands
+        .iter()
+        .filter(|c| c.name == "deep-research")
+        .collect();
+    assert_eq!(dr_cmds.len(), 1);
+    let cmd = dr_cmds[0];
+    let meta = cmd.meta.as_ref().expect("skill metadata");
+    assert_eq!(
+        meta.get("bareName").and_then(|v| v.as_str()),
+        Some("deep-research")
+    );
+
+    let availability_on = CommandAvailability {
+        builtin_deep_research: true,
+        ..CommandAvailability::all_enabled()
+    };
+    let commands_on = available_commands(&[skill], availability_on, &[]);
+    let bare_cmds: Vec<_> = commands_on
+        .iter()
+        .filter(|c| c.name == "deep-research")
+        .collect();
+    assert_eq!(bare_cmds.len(), 1);
+    assert_eq!(
+        bare_cmds[0].description,
+        "Research with bounded parallel agents, cross-check evidence, and write a cited report"
+    );
