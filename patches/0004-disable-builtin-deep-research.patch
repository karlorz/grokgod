+pub(super) fn set_workflow_builtin_deep_research_inner(app: &mut AppView, new: bool) {
+    app.workflow_builtin_deep_research = Some(new);
+}
+
+/// SHELL-owned setter for `[workflows.builtins] deep-research`; persists via
+/// `Effect::PersistSetting`. Live slash update via AvailableCommandsUpdate.
+pub(in crate::app::dispatch) fn set_workflow_builtin_deep_research(
+    app: &mut AppView,
+    new: bool,
+) -> Vec<Effect> {
+    let prev_state = app.workflow_builtin_deep_research;
+    let prev_effective = prev_state.unwrap_or(true);
+    if prev_effective == new && prev_state.is_some() {
+        return vec![];
+    }
+    set_workflow_builtin_deep_research_inner(app, new);
+    refresh_open_settings_modals(app);
+    for agent in app.agents.values_mut() {
+        if let Some(ref mut modal) = agent.extensions_modal {
+            if let crate::views::extensions_modal::TabDataState::Loaded(ref mut workflows) =
+                modal.workflows_data
+            {
+                for wf in workflows.iter_mut() {
+                    if crate::views::extensions_modal::workflow_is_togglable(wf) {
+                        wf.enabled = new;
+                    }
+                }
+            }
+            modal.pending_action = None;
+            modal.pending_entry_index = None;
+        }
+    }
+    tracing::info!(
+        target: "settings",
+        key = "workflows.builtins.deep-research",
+        value = new,
+        "setting changed",
+    );
+    app.show_toast(&save_success_toast("Built-in deep-research workflow", new));
+    vec![Effect::PersistSetting {
+        key: "workflows.builtins.deep-research",
+        value: crate::settings::SettingValue::Bool(new),
+        rollback_value: crate::settings::SettingValue::Bool(prev_effective),
+    }]
+}
