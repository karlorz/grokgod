+#[test]
+#[serial]
+fn toml_deser_workflows_builtins_deep_research() {
+    let toml_str = r#"
+[workflows.builtins]
+deep-research = false
+"#;
+    let raw: toml::Value = toml::from_str(toml_str).unwrap();
+    let cfg = Config::new_from_toml_cfg(&raw).unwrap();
+    assert_eq!(cfg.workflows.builtins.deep_research, Some(false));
+    assert!(!cfg.resolve_workflow_builtin_deep_research().value);
+
+    let toml_empty = "";
+    let raw_empty: toml::Value = toml::from_str(toml_empty).unwrap();
+    let cfg_empty = Config::new_from_toml_cfg(&raw_empty).unwrap();
+    assert_eq!(cfg_empty.workflows.builtins.deep_research, None);
+    assert!(cfg_empty.resolve_workflow_builtin_deep_research().value);
+}
