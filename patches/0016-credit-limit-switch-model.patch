+#[test]
+fn credit_limit_switch_model_action_opens_direct_picker_without_mutating_session_or_prompts() {
+    use crate::views::modal::ActiveModal;
+
+    let mut app = test_app_with_agent();
+    let id = AgentId(0);
+    let model_id = acp::ModelId::new(std::sync::Arc::from("alternate-model"));
+    let agent = app.agents.get_mut(&id).unwrap();
+    agent.session.models.available.insert(
+        model_id.clone(),
+        acp::ModelInfo::new(model_id, "Alternate Model".to_string()),
+    );
+    agent.prompt.set_text("draft stays here");
+    agent.credit_limit_stashed_prompt = Some(test_stashed_prompt("retry me"));
+    let session_id = agent.session.session_id.clone();
+
+    let effects = dispatch(Action::OpenCreditLimitModelPicker, &mut app);
+    assert!(effects.is_empty());
+    let agent = test_agent(&app, id);
+    assert!(matches!(
+        agent.active_modal,
+        Some(ActiveModal::ArgPicker {
+            ref command,
+            previous_palette: None,
+            ..
+        }) if command == "model"
+    ));
+    assert_eq!(agent.prompt.text(), "draft stays here");
+    assert_eq!(agent.session.session_id, session_id);
+    assert_eq!(
+        agent
+            .credit_limit_stashed_prompt
+            .as_ref()
+            .map(|prompt| prompt.text.as_str()),
+        Some("retry me")
+    );
+    assert!(agent.credit_limit_model_retry_pending);
+}
