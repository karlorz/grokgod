+#[cfg(test)]
+mod credit_limit_model_picker_tests {
+    use super::*;
+    use crate::app::agent::InFlightPrompt;
+    use crate::app::agent_view::test_fixtures::make_agent;
+    use crossterm::event::{
+        Event, KeyCode, KeyEvent, KeyModifiers, MouseButton, MouseEvent, MouseEventKind,
+    };
+    use ratatui::layout::Rect;
+
+    fn credit_limit_model_picker_agent() -> AgentView {
+        crate::appearance::cache::set_vim_mode(false);
+        let mut agent = make_agent();
+        let model_id = agent_client_protocol::ModelId::new(std::sync::Arc::from("alternate"));
+        agent.session.models.available.insert(
+            model_id.clone(),
+            agent_client_protocol::ModelInfo::new(model_id, "Alternate".to_string()),
+        );
+        agent.credit_limit_stashed_prompt = Some(InFlightPrompt {
+            text: "retry me".into(),
+            images: Vec::new(),
+            scrollback_entry: crate::scrollback::EntryId::new(0),
+            combined_scrollback_entries: Vec::new(),
+            chip_elements: Vec::new(),
+        });
+        assert!(agent.open_model_arg_picker());
+        agent.credit_limit_model_retry_pending = true;
+        agent
+    }
+
+    fn assert_retry_cancelled_with_prompt_preserved(agent: &AgentView) {
+        assert!(agent.active_modal.is_none());
+        assert!(!agent.credit_limit_model_retry_pending);
+        assert_eq!(
+            agent
+                .credit_limit_stashed_prompt
+                .as_ref()
+                .map(|prompt| prompt.text.as_str()),
+            Some("retry me")
+        );
+    }
+
+    #[test]
+    fn keyboard_esc_dismisses_credit_limit_model_picker_and_preserves_prompt() {
+        let mut agent = credit_limit_model_picker_agent();
+
+        let outcome = agent.handle_palette_or_arg_input(&Event::Key(KeyEvent::new(
+            KeyCode::Esc,
+            KeyModifiers::NONE,
+        )));
+
+        assert!(matches!(outcome, InputOutcome::Changed));
+        assert_retry_cancelled_with_prompt_preserved(&agent);
+    }
+
+    #[test]
+    fn mouse_window_close_dismisses_credit_limit_model_picker_and_preserves_prompt() {
+        let mut agent = credit_limit_model_picker_agent();
+        let Some(ActiveModal::ArgPicker { window, .. }) = agent.active_modal.as_mut() else {
+            panic!("expected model argument picker");
+        };
+        window.popup_area = Some(Rect::new(10, 5, 80, 30));
+
+        let outcome = agent.handle_modal_mouse_with_registry(
+            &MouseEvent {
+                kind: MouseEventKind::Down(MouseButton::Left),
+                column: 5,
+                row: 5,
+                modifiers: KeyModifiers::NONE,
+            },
+            &crate::actions::ActionRegistry::defaults(),
+        );
+
+        assert!(matches!(outcome, InputOutcome::Changed));
+        assert_retry_cancelled_with_prompt_preserved(&agent);
+    }
+}
