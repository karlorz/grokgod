+/// Deserialize a Chat Completions SSE chunk.
+///
+/// Strict parse first. On missing-field or JSON-null errors, apply an
+/// allowlisted compact-JSON policy (choice/tool-call `index`, empty
+/// `delta`, usage ints) and retry once. Identity fields (`id`, `object`,
+/// `created`, `model`) and tool-call `id` are never invented.
+fn deserialize_chat_completion_chunk(data: &str) -> Result<ChatCompletionChunk> {
+    match serde_json::from_str::<ChatCompletionChunk>(data) {
+        Ok(chunk) => Ok(chunk),
+        Err(first_err) => {
+            if is_compact_retryable_chat_chunk_error(&first_err) {
+                if let Ok(mut value) = serde_json::from_str::<serde_json::Value>(data) {
+                    sanitize_chat_completion_chunk_compact(&mut value);
+                    if let Ok(chunk) = ChatCompletionChunk::deserialize(&value) {
+                        tracing::warn!(
+                            error = %first_err,
+                            "Retrying ChatCompletionChunk deserialize after compact-JSON sanitize"
+                        );
+                        return Ok(chunk);
+                    }
+                }
+            }
+            tracing::error!(
+                error = %first_err,
+                raw_data = %data,
+                "Failed to deserialize ChatCompletionChunk from stream"
+            );
+            Err(SamplingError::Serialization(first_err))
+        }
+    }
+}
+
+fn is_compact_retryable_chat_chunk_error(err: &serde_json::Error) -> bool {
+    let msg = err.to_string();
+    msg.contains("missing field") || msg.contains("invalid type: null")
+}
+
+fn fill_u32_if_null_or_missing(obj: &mut serde_json::Map<String, serde_json::Value>, key: &str) {
+    match obj.get(key) {
+        None | Some(serde_json::Value::Null) => {
+            obj.insert(key.to_string(), serde_json::json!(0));
+        }
+        _ => {}
+    }
+}
+
+/// Allowlisted compact-JSON defaults for wrapper-shaped Chat Completions chunks.
+/// Does not invent top-level identity fields or tool-call ids.
+fn sanitize_chat_completion_chunk_compact(value: &mut serde_json::Value) {
+    let Some(root) = value.as_object_mut() else {
+        return;
+    };
+
+    if let Some(choices) = root.get_mut("choices").and_then(|v| v.as_array_mut()) {
+        for choice in choices {
+            let Some(choice_obj) = choice.as_object_mut() else {
+                continue;
+            };
+            fill_u32_if_null_or_missing(choice_obj, "index");
+            match choice_obj.get("delta") {
+                None | Some(serde_json::Value::Null) => {
+                    choice_obj.insert("delta".to_string(), serde_json::json!({}));
+                }
+                _ => {}
+            }
+            if let Some(delta) = choice_obj.get_mut("delta").and_then(|v| v.as_object_mut()) {
+                if let Some(tool_calls) = delta.get_mut("tool_calls").and_then(|v| v.as_array_mut())
+                {
+                    for tool_call in tool_calls {
+                        if let Some(tc) = tool_call.as_object_mut() {
+                            fill_u32_if_null_or_missing(tc, "index");
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    if let Some(usage) = root.get_mut("usage").and_then(|v| v.as_object_mut()) {
+        for key in ["prompt_tokens", "completion_tokens", "total_tokens"] {
+            fill_u32_if_null_or_missing(usage, key);
+        }
+        if let Some(details) = usage
+            .get_mut("prompt_tokens_details")
+            .and_then(|v| v.as_object_mut())
+        {
+            for key in ["cached_tokens", "audio_tokens"] {
+                fill_u32_if_null_or_missing(details, key);
+            }
+        }
+        if let Some(details) = usage
+            .get_mut("completion_tokens_details")
+            .and_then(|v| v.as_object_mut())
+        {
+            for key in [
+                "reasoning_tokens",
+                "audio_tokens",
+                "accepted_prediction_tokens",
+                "rejected_prediction_tokens",
+            ] {
+                fill_u32_if_null_or_missing(details, key);
+            }
+        }
+    }
+}
