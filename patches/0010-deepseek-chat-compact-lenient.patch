+    /// Compact CPA/Poe Chat Completions tool-call chunk omitting choices[0].index.
+    /// Live 2026-08-31: `missing field index` at column ~324.
+    #[test]
+    fn deserialize_chat_completion_chunk_defaults_missing_choice_index() {
+        let json = r#"{"id":"chatcmpl-compact","object":"chat.completion.chunk","created":1756622681,"model":"deepseek-v4-flash","choices":[{"delta":{"tool_calls":[{"index":0,"id":"call_web","type":"function","function":{"name":"web_search","arguments":"{\"query\":\"ai news\"}"}}]},"finish_reason":null}]}"#;
+        let chunk = deserialize_chat_completion_chunk(json)
+            .expect("compact chunk missing choice index should deserialize");
+        assert_eq!(chunk.choices[0].index, 0);
+        assert_eq!(
+            chunk.choices[0].delta.tool_calls[0].id.as_deref(),
+            Some("call_web")
+        );
+    }
