+/// Parse an ACP elicit response and reject persist on decline/cancel or malformed persist.
+pub fn parse_mcp_elicit_ext_response(raw: &str) -> Result<McpElicitExtResponse, String> {
+    let value: Value =
+        serde_json::from_str(raw).map_err(|e| format!("mcp elicit response is not JSON: {e}"))?;
+    let Value::Object(map) = &value else {
+        return Err("mcp elicit response must be an object".into());
+    };
+    let outcome = map.get("outcome").and_then(Value::as_str);
+    if matches!(outcome, Some("decline" | "cancel")) && map.contains_key("persist") {
+        return Err("persist is not allowed on decline/cancel".into());
