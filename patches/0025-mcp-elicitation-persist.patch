+/// Reviewed Computer Use persist scopes. Unknown MCP tokens are dropped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum McpElicitPersistScope {
+    Session,
+    Always,
+}
+
+impl McpElicitPersistScope {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Session => "session",
+            Self::Always => "always",
+        }
+    }
+
+    fn from_token(token: &str) -> Option<Self> {
+        match token {
+            "session" => Some(Self::Session),
+            "always" => Some(Self::Always),
+            _ => None,
+        }
+    }
+}
+
+/// Keep session then always, unique. Empty or malformed input becomes `None`.
+pub fn normalize_persist_offer(value: &Value) -> Option<Vec<McpElicitPersistScope>> {
+    let Value::Array(items) = value else {
+        return None;
+    };
+    let mut session = false;
+    let mut always = false;
+    for item in items {
+        let Value::String(token) = item else {
+            return None;
+        };
+        match McpElicitPersistScope::from_token(token) {
+            Some(McpElicitPersistScope::Session) => session = true,
+            Some(McpElicitPersistScope::Always) => always = true,
+            None => {}
+        }
+    }
+    let mut out = Vec::new();
+    if session {
+        out.push(McpElicitPersistScope::Session);
+    }
+    if always {
+        out.push(McpElicitPersistScope::Always);
+    }
+    if out.is_empty() { None } else { Some(out) }
+}
+
 /// Per-mode fields of an elicitation request, internally tagged with the wire `mode` key ("form" /
