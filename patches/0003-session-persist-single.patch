+#[test]
+fn session_persist_single_explicit_true_round_trips() {
+    let raw_config: TomlValue = toml::from_str(
+        r#"
+            [session]
+            persist_single = true
+            "#,
+    )
+    .unwrap();
+    let cfg = load_config_from_toml(&raw_config);
+    assert_eq!(
+        cfg.session.persist_single,
+        Some(true),
+        "explicit persist_single = true on disk must load as Some(true), not None"
+    );
+    let mut table = TomlMap::new();
+    merge_section(&mut table, "session", &cfg.session);
+    let session = table.get("session").unwrap().as_table().unwrap();
+    assert_eq!(
+        session.get("persist_single").and_then(|v| v.as_bool()),
+        Some(true),
+        "explicit persist_single = true must survive a save"
+    );
 }
