+
+/// Convert a wait budget into the optional wire countdown deadline.
+///
+/// The deadline is wall-clock (the client renders it), derived from the same
+/// duration the native monotonic timer sleeps for. `None` when the sum leaves
+/// the signed 64-bit millisecond range, so a bogus budget can never emit an
+/// overflowing timestamp.
+pub fn ask_user_question_timeout(
+    budget: std::time::Duration,
+    action: TimeoutAction,
+) -> Option<AskUserQuestionTimeout> {
+    let now_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .ok()?
+        .as_millis();
+    let now_ms = i128::try_from(now_ms).ok()?;
+    let budget_ms = i128::try_from(budget.as_millis()).ok()?;
+    let deadline = i64::try_from(now_ms.checked_add(budget_ms)?).ok()?;
+    Some(AskUserQuestionTimeout {
+        deadline_unix_ms: deadline,
+        action,
+    })
 }
 
