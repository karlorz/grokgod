@echo off
rem grokgod thin launcher for Windows (grok)
setlocal
set "GROKGOD_SHIM_DIR=%~dp0"
if exist "%GROKGOD_SHIM_DIR%grok-shim.ps1" (
    set "GROKGOD_SHIM_PATH=%GROKGOD_SHIM_DIR%grok-shim.ps1"
) else if exist "%GROKGOD_SHIM_DIR%..\grokgod\src\shim\grok-shim.ps1" (
    set "GROKGOD_SHIM_PATH=%GROKGOD_SHIM_DIR%..\grokgod\src\shim\grok-shim.ps1"
) else if exist "%USERPROFILE%\.grokgod\src\shim\grok-shim.ps1" (
    set "GROKGOD_SHIM_PATH=%USERPROFILE%\.grokgod\src\shim\grok-shim.ps1"
) else if exist "%USERPROFILE%\.grokgod\grok-shim.ps1" (
    set "GROKGOD_SHIM_PATH=%USERPROFILE%\.grokgod\grok-shim.ps1"
) else (
    set "GROKGOD_SHIM_PATH=grok-shim.ps1"
)

set "POWERSHELL_EXE="
pwsh.exe -NoProfile -Command "exit 0" >nul 2>&1
if errorlevel 1 goto try_powershell
set "POWERSHELL_EXE=pwsh.exe"
goto powershell_ready

:try_powershell
powershell.exe -NoProfile -Command "exit 0" >nul 2>&1
if errorlevel 1 goto powershell_unavailable
set "POWERSHELL_EXE=powershell.exe"
goto powershell_ready

:powershell_unavailable
>&2 echo grokgod: no runnable PowerShell engine found (pwsh.exe or powershell.exe)
exit /b 127

:powershell_ready

"%POWERSHELL_EXE%" -NoProfile -ExecutionPolicy Bypass -File "%GROKGOD_SHIM_PATH%" grok %*
exit /b %ERRORLEVEL%
