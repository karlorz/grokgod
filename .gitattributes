patches/*.patch text eol=lf
# Generated installers and their canonical sources must stay byte-reproducible
# on every platform: build.mjs compares generated bytes, so a checkout that
# rewrites line endings would report permanent drift.
install.sh text eol=lf
install.ps1 text eol=lf
src/installer/** text eol=lf
src/shim/*.sh text eol=lf
src/shim/*.ps1 text eol=lf
src/shim/templates/*.template text eol=lf
